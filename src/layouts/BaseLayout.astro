---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrivacyModal from '../components/PrivacyModal.astro';
import type { Locale } from '../i18n/types';
import { getLangFromUrl } from '../i18n/utils';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  lang?: Locale;
  alternates?: Record<Locale | 'x-default', string>;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const detectedLang = getLangFromUrl(Astro.url);
const {
  title,
  description,
  keywords,
  canonicalUrl,
  lang = detectedLang,
  alternates,
  schema,
} = Astro.props;
---

<!doctype html>
<html lang={lang} data-page-lang={lang} class="scroll-smooth">
  <head>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      canonicalUrl={canonicalUrl}
      lang={lang}
      alternates={alternates}
      schema={schema}
    />
    <!-- Inline anti-FOUC script for theme selection -->
    <script is:inline>
      (function () {
        try {
          const savedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch {
          // LocalStorage inaccessible or disabled
        }
      })();
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 antialiased font-sans selection:bg-teal-500 selection:text-white transition-colors duration-200 min-h-screen flex flex-col">
    <Header lang={lang} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
    <PrivacyModal lang={lang} />

    <!-- Shared Client Runtime -->
    <script is:inline src="/js/translations.js"></script>
    <script is:inline src="/js/main.js"></script>
  </body>
</html>

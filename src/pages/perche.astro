---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEMO_URL } from '../data/links';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = t.perche;

const pointIcons = [
  {
    path: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    box: 'bg-teal-50 dark:bg-teal-950/60 border-teal-200 dark:border-teal-800 text-teal-600 dark:text-teal-400',
    reverse: false,
  },
  {
    path: 'M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 4.243a9 9 0 01-12.728 0m0 0l2.829-2.829m-2.829 2.829L3 21',
    box: 'bg-emerald-50 dark:bg-emerald-950/60 border-emerald-200 dark:border-emerald-800 text-emerald-600 dark:text-emerald-400',
    reverse: true,
  },
  {
    path: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    box: 'bg-slate-100 dark:bg-slate-800 border-slate-200 dark:border-slate-700 text-slate-800 dark:text-slate-200',
    reverse: false,
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: p.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/perche/', lang)}`,
  inLanguage: lang,
  description: p.seo.description,
  publisher: {
    '@type': 'Organization',
    name: 'FatturaFacile Team',
  },
};
---

<BaseLayout
  title={p.seo.title}
  description={p.seo.description}
  keywords={p.seo.keywords}
  lang={lang}
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 dark:bg-teal-950/70 text-teal-800 dark:text-teal-300 mb-6">
        {p.eyebrow}
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {p.headingPre}{' '}
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-emerald-600 dark:from-teal-400 dark:to-emerald-400">
          {p.headingHighlight}
        </span>
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed">
        {p.lead}
      </p>
    </div>
  </section>

  <!-- Deep Dive Content -->
  <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {p.points.map((point, i) => (
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
          <div
            class={`md:col-span-4 flex justify-center ${pointIcons[i].reverse ? 'md:order-last' : ''}`}
          >
            <div
              class={`w-24 h-24 rounded-3xl border flex items-center justify-center shadow-md ${pointIcons[i].box}`}
            >
              <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={pointIcons[i].path}
                />
              </svg>
            </div>
          </div>
          <div class="md:col-span-8">
            <h2 class="text-2xl font-bold text-slate-900 dark:text-white">{point.title}</h2>
            <p class="mt-3 text-slate-600 dark:text-slate-300 leading-relaxed">{point.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- La Nostra Storia Section (#storia) -->
  <section
    id="storia"
    class="py-16 sm:py-24 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 scroll-mt-20"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800 mb-3">
          {p.story.badge}
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {p.story.title}
        </h2>
      </div>

      <div class="prose prose-slate dark:prose-invert max-w-none space-y-6 text-sm sm:text-base leading-relaxed text-slate-600 dark:text-slate-300">
        <p>
          {p.story.p1Pre} <strong>FatturaFacile</strong> {p.story.p1Post}
        </p>
        <p>
          {p.story.askPre} <em>{p.story.quote}</em>
        </p>
        <p>{p.story.p3}</p>
      </div>
    </div>
  </section>

  <!-- Team & Contributori Anchor (#team) -->
  <section
    id="team"
    class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 scroll-mt-20"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-4">
        {p.team.title}
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-8">
        {p.team.lead}
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href={`${getLocalizedPath('/community-richieste/', lang)}#collaborare`}
          class="px-6 py-3 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded-xl text-sm transition-colors shadow-md"
        >
          {p.team.joinBtn} &rarr;
        </a>
        <a
          href="https://github.com/FatturaFacile"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-bold rounded-xl text-sm transition-colors border border-slate-200 dark:border-slate-700"
        >
          {p.team.githubBtn}
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-16 bg-slate-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-extrabold tracking-tight">{p.cta.title}</h2>
      <p class="mt-4 text-slate-300">{p.cta.lead}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={DEMO_URL}
          target="_blank"
          rel="noopener"
          class="px-8 py-3.5 bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold rounded-2xl transition-all shadow-lg"
        >
          {t.common.actions.tryDemo}
        </a>
        <a
          href={getLocalizedPath('/funzionalita/', lang)}
          class="px-8 py-3.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold rounded-2xl transition-all"
        >
          {p.cta.features}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.community;

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: c.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/community/', lang)}`,
  inLanguage: lang,
  description: c.seo.description,
  publisher: {
    '@type': 'Organization',
    name: 'FatturaFacile Community',
    url: 'https://fatturafacile.eu/',
  },
};
---

<BaseLayout
  title={c.seo.title}
  description={c.seo.description}
  keywords={c.seo.keywords}
  lang={lang}
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 dark:bg-teal-950/70 text-teal-800 dark:text-teal-300 mb-6">
        {c.eyebrow}
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {c.heading}
      </h1>
      <p class="mt-6 text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl mx-auto">
        {c.lead}
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://github.com/FatturaFacile"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-slate-900 dark:bg-teal-600 hover:bg-slate-800 dark:hover:bg-teal-500 text-white font-bold rounded-2xl shadow-lg transition-all"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span>{c.actions.githubBtn}</span>
        </a>

        <a
          href="https://t.me/+sRauQINBDFQ5NjU0"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3.5 bg-teal-50 dark:bg-teal-950/70 hover:bg-teal-100 dark:hover:bg-teal-900 text-teal-800 dark:text-teal-300 font-bold border border-teal-200 dark:border-teal-800 rounded-2xl shadow-sm transition-all"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z" />
          </svg>
          <span>{c.actions.telegramBtn}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 1. Concrete Educational Opportunities -->
  <section class="py-16 sm:py-24 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
          {c.educationSection.badge}
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {c.educationSection.title}
        </h2>
        <p class="mt-4 text-base text-slate-600 dark:text-slate-300">{c.educationSection.lead}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {c.educationSection.institutions.map((inst) => (
          <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-4 mb-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800">
                  {inst.role}
                </span>
                <span class="text-xs font-bold text-slate-400">🇨🇭 Canton Ticino</span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{inst.name}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{inst.desc}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-200/80 dark:border-slate-800 text-xs text-teal-600 dark:text-teal-400 font-semibold">
              Progetti di tesi, stage curriculari e sperimentazione guidata &rarr;
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. How to Participate -->
  <section class="py-16 sm:py-24 bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
          {c.participationSection.badge}
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {c.participationSection.title}
        </h2>
        <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
          {c.participationSection.lead}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {c.participationSection.profiles.map((p) => (
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div>
              <span class="inline-flex px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 mb-4">
                {p.badge}
              </span>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{p.title}</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                {p.desc}
              </p>
            </div>
            <a
              href="https://github.com/FatturaFacile"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-600 dark:text-teal-400 hover:underline"
            >
              <span>{p.action}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Code Transparency & MIT License -->
  <section class="py-16 sm:py-24 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
          {c.transparencySection.badge}
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {c.transparencySection.title}
        </h2>
        <p class="mt-4 text-base text-slate-600 dark:text-slate-300">
          {c.transparencySection.lead}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {c.transparencySection.points.map((pt) => (
          <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{pt.title}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{pt.desc}</p>
          </div>
        ))}
      </div>

      <!-- Action Footer -->
      <div class="mt-16 text-center">
        <a
          href={getLocalizedPath('/community-richieste/', lang)}
          class="inline-flex items-center gap-2 px-8 py-3.5 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded-xl text-sm shadow-md transition-all"
        >
          <span>{c.actions.requestBtn}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.moduli.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/funzionalita/', lang)}`,
  inLanguage: lang,
  description: t.moduli.seo.description,
  publisher: {
    '@type': 'Organization',
    name: 'Fattura Facile Teams',
  },
};

const modules = [
  {
    id: 'invoicing-engine',
    title: 'Motore di Fatturazione & Numerazione',
    badge: 'Core',
    badgeColor: 'bg-teal-100 text-teal-800 dark:bg-teal-950 dark:text-teal-300',
    desc: 'Emissione immediata di fatture commerciali e parcelle professionali in meno di 30 secondi. Gestione automatica della numerazione progressiva annuale, calcolo scorporo o imponibile, sconti e note di credito.',
    features: [
      'Numerazione progressiva per anno/sezionale',
      'Calcolo automatico totali e imposte',
      'Generazione PDF vettoriale nitido da stampare o inviare',
    ],
  },
  {
    id: 'quick-quotes',
    title: 'Preventivi Rapidi sul Campo',
    badge: '1-Click Convert',
    badgeColor: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300',
    desc: 'Crea il preventivo sul portatile o chiavetta direttamente dal cliente durante il sopralluogo in cantiere. Quando il cliente accetta, un singolo click converte il preventivo in fattura senza dover ridigitare una sola riga.',
    features: [
      'Stima immediata di materiali e manodopera',
      'Tracking stato: Bozza, Inviato, Accettato, Rifiutato',
      'Conversione istantanea in fattura ufficiale',
    ],
  },
  {
    id: 'fatturapa-sdi',
    title: 'Modulo Fattura Elettronica Italia (SDI)',
    badge: 'Italia 🇮🇹',
    badgeColor: 'bg-blue-100 text-blue-800 dark:bg-blue-950 dark:text-blue-300',
    desc: "Generazione certificata di file XML FatturaPA conformi alle specifiche dell'Agenzia delle Entrate per la trasmissione al Sistema di Interscambio (SDI) tramite PEC o Codice Destinatario.",
    features: [
      'Supporto B2B, B2C e Pubblica Amministrazione',
      'Regime Forfettario con bollo virtuale automatico',
      "Ritenuta d'acconto 20% e Casse Previdenziali",
    ],
  },
  {
    id: 'qr-bill-ch',
    title: 'Modulo Svizzera QR-Bill (SIX Standard)',
    badge: 'Svizzera 🇨🇭',
    badgeColor: 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-300',
    desc: 'Generazione ufficiale della sezione di pagamento con codice QR svizzero e croce elvetica unificata, pronta per la scansione da e-banking o pagamento allo sportello.',
    features: [
      'Codici QR vettoriali conformi alle direttive SIX',
      'Aliquote IVA Svizzere (8.1%, 2.6%, 3.8%)',
      'Valute CHF ed EUR con riferimenti strutturati',
    ],
  },
  {
    id: 'encrypted-backups',
    title: 'Snapshot & Backup Crittografato 1-Click',
    badge: 'Sicurezza',
    badgeColor: 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300',
    desc: 'Nessun rischio di smarrimento dati. Con un solo tasto generi un archivio compresso e protetto da password contenente il database SQLite, i PDF e le impostazioni.',
    features: [
      'Archivio ZIP completo portabile',
      'Crittografia AES per proteggere i dati dei clienti',
      'Copia immediata su chiavetta secondaria o cloud',
    ],
  },
];

const roadmapItems = [
  {
    title: 'Scadenzario Incassi & Solleciti Cortesi',
    status: 'In Sviluppo',
    eta: 'Q2 2026',
    desc: "Panoramica a colpo d'occhio delle fatture scadute con generazione di testo precompilato per avviso amichevole via email o WhatsApp.",
  },
  {
    title: 'Registro Cassa & Spese Fornitori',
    status: 'Pianificato',
    eta: 'Q3 2026',
    desc: 'Tracciamento semplificato delle uscite e delle ricevute di acquisto per verificare il margine reale a fine mese.',
  },
  {
    title: 'Scorte & Magazzino Base per Artigiani',
    status: 'Pianificato',
    eta: 'Q4 2026',
    desc: 'Controllo disponibilità pezzi di ricambio e minuteria più usata in furgone con avviso di scorta minima.',
  },
  {
    title: 'Import / Export CSV & Anagrafiche Clienti',
    status: 'In Valutazione',
    eta: 'Community Driven',
    desc: "Modulo per caricare o esportare l'elenco clienti e listino prezzi da Excel o rubrica.",
  },
];
---

<BaseLayout
  title={t.moduli.seo.title}
  description={t.moduli.seo.description}
  keywords={t.moduli.seo.keywords}
  lang={lang}
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/60 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800/60 mb-6">
        <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
        Catalogo Moduli & Specifiche Fiscali
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Ogni Funzione Progettata per la
        <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-emerald-600 dark:from-teal-400 dark:to-emerald-400">
          Semplicità Quotidiana
        </span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Niente funzioni superflue che rallentano il lavoro. Solo ciò che serve davvero a chi lavora
        sul campo in Italia e Svizzera: preventivi, fatture a norma, incassi e salvataggi sicuri.
      </p>
    </div>
  </section>

  <!-- Modules Catalog Section -->
  <section id="catalogo" class="py-16 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10 pb-4 border-b border-slate-200 dark:border-slate-800">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
            Moduli Disponibili & Pronti all'Uso
          </h2>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
            Inclusi gratuitamente sia nella versione Desktop portabile che nella versione Cloud
            Docker
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {modules.map((mod) => (
          <div class="flex flex-col justify-between bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 hover:shadow-xl transition-all">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class={`px-2.5 py-1 rounded-full text-xs font-bold ${mod.badgeColor}`}>
                  {mod.badge}
                </span>
              </div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{mod.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                {mod.desc}
              </p>
            </div>

            <ul class="space-y-2 border-t border-slate-200 dark:border-slate-800 pt-4 text-xs text-slate-600 dark:text-slate-400">
              {mod.features.map((f) => (
                <li class="flex items-center gap-2">
                  <span class="text-teal-600 dark:text-teal-400 font-bold">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Public Roadmap Section -->
  <section
    id="roadmap"
    class="py-16 bg-slate-50 dark:bg-slate-900/50 border-t border-slate-200/80 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
          Trasparenza & Sviluppo Continuo
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          Roadmap Pubblica dei Moduli
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">
          Ecco i moduli richiesti dagli utenti attualmente in fase di progettazione e collaudo. Hai
          bisogno di un'altra funzione?
          <a
            href="/community-richieste/"
            class="text-teal-600 dark:text-teal-400 font-bold hover:underline"
          >
            Richiedila gratuitamente
          </a>
          .
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {roadmapItems.map((item) => (
          <div class="p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-4 mb-2">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">{item.title}</h3>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 shrink-0">
                  {item.eta}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
                {item.desc}
              </p>
            </div>
            <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800 text-xs">
              <span class="text-slate-500 dark:text-slate-400">Stato:</span>
              <span class="font-bold text-teal-600 dark:text-teal-400">{item.status}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href="/community-richieste/"
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-slate-900 dark:bg-teal-600 hover:bg-slate-800 dark:hover:bg-teal-500 text-white font-bold rounded-xl text-sm shadow-md transition-colors"
        >
          Proponi un Nuovo Modulo alla Community &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

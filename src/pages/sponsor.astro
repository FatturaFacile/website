---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const sp = t.sponsor;

const costStyles = [
  {
    box: 'bg-teal-100 dark:bg-teal-950/80 text-teal-600 dark:text-teal-400',
    tag: 'text-teal-600 dark:text-teal-400',
    path: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
  {
    box: 'bg-cyan-100 dark:bg-cyan-950/80 text-cyan-600 dark:text-cyan-400',
    tag: 'text-cyan-600 dark:text-cyan-400',
    path: 'M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01',
  },
  {
    box: 'bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400',
    tag: 'text-emerald-600 dark:text-emerald-400',
    path: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  },
];

// Style and links of the three tiers, in the same order as t.sponsor.tiers.items.
const tierStyles = [
  {
    card: 'border border-slate-200 dark:border-slate-800 shadow-md',
    audience: 'text-teal-600 dark:text-teal-400',
    check: 'text-emerald-500',
    cta: 'bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-900 dark:text-white',
    href: 'https://github.com/sponsors/FatturaFacile',
    external: true,
  },
  {
    card: 'border-2 border-teal-500 shadow-xl relative',
    audience: 'text-teal-600 dark:text-teal-400',
    check: 'text-teal-500 font-bold',
    cta: 'bg-teal-600 hover:bg-teal-500 text-white shadow-md',
    href: 'mailto:sponsor@fatturafacile.eu?subject=[Sponsor%20Tecnologico]',
    external: false,
  },
  {
    card: 'border border-slate-200 dark:border-slate-800 shadow-md',
    audience: 'text-slate-500 dark:text-slate-400',
    check: 'text-emerald-500',
    cta: 'bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white',
    href: 'mailto:sponsor@fatturafacile.eu?subject=[Main%20Sponsorship]',
    external: false,
  },
];

const sponsorSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: sp.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/sponsor/', lang)}`,
  inLanguage: lang,
  description: sp.seo.description,
};
---

<BaseLayout
  title={sp.seo.title}
  description={sp.seo.description}
  keywords={sp.seo.keywords}
  lang={lang}
  schema={sponsorSchema}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/60 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        {sp.hero.badge}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        {sp.hero.headingPre}
        <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-emerald-600 dark:from-teal-400 dark:to-emerald-400">
          {sp.hero.headingHighlight}
        </span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        {sp.hero.lead}
      </p>
    </div>
  </section>

  <!-- Costs & Transparency Section -->
  <section class="py-16 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {sp.costs.title}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">{sp.costs.lead}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sp.costs.items.map((item, i) => (
          <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div
              class={`w-12 h-12 rounded-2xl flex items-center justify-center mb-6 ${costStyles[i].box}`}
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={costStyles[i].path}
                />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">{item.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
              {item.desc}
            </p>
            <span class={`text-xs font-semibold ${costStyles[i].tag}`}>{item.priority}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sponsorship Tiers Section -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/50 border-t border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {sp.tiers.title}
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">{sp.tiers.lead}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sp.tiers.items.map((tier, i) => (
          <div
            class={`p-8 rounded-3xl bg-white dark:bg-slate-900 flex flex-col justify-between ${tierStyles[i].card}`}
          >
            {i === 1 && (
              <div class="absolute -top-3 right-6 bg-teal-600 text-white text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-full">
                {sp.tiers.recommended}
              </div>
            )}
            <div>
              <div
                class={`text-xs font-bold uppercase tracking-wider mb-2 ${tierStyles[i].audience}`}
              >
                {tier.audience}
              </div>
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">{tier.name}</h3>
              <div class="text-3xl font-black text-slate-900 dark:text-white mb-4">
                {tier.price}{' '}
                <span class="text-sm font-normal text-slate-500">{tier.priceNote}</span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
                {tier.desc}
              </p>
              <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800 pt-4">
                {tier.perks.map((perk) => (
                  <li class="flex items-center gap-2">
                    <span class={tierStyles[i].check}>✓</span> {perk}
                  </li>
                ))}
              </ul>
            </div>
            <div class="mt-8">
              <a
                href={tierStyles[i].href}
                target={tierStyles[i].external ? '_blank' : undefined}
                rel={tierStyles[i].external ? 'noopener noreferrer' : undefined}
                class={`w-full inline-flex items-center justify-center gap-2 px-6 py-3 font-bold rounded-xl text-xs transition-colors ${tierStyles[i].cta}`}
              >
                {tier.cta}
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

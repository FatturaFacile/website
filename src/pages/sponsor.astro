---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sponsorSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.sponsor.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/sponsor/', lang)}`,
  inLanguage: lang,
  description: t.sponsor.seo.description,
};
---

<BaseLayout
  title={t.sponsor.seo.title}
  description={t.sponsor.seo.description}
  keywords={t.sponsor.seo.keywords}
  lang={lang}
  schema={sponsorSchema}
>
  <!-- Hero Section -->
  <section class="py-16 sm:py-20 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/60 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Sostenibilità & Indipendenza
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Sostieni il Software Libero
        <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-emerald-600 dark:from-teal-400 dark:to-emerald-400">
          per Artigiani e Piccole Imprese
        </span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Fattura Facile è e resterà sempre gratuito per chi lo utilizza. Non vendiamo dati, non
        imponiamo canoni e non mostriamo pubblicità. Scopri dove vanno i fondi e come puoi
        contribuire come azienda o singolo professionista.
      </p>
    </div>
  </section>

  <!-- Costs & Transparency Section -->
  <section class="py-16 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Perché Abbiamo Bisogno di Sponsor?
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">
          Il tempo degli ingegneri del team è donato pro bono alla community. Tuttavia, il mondo del
          software professionale richiede costi vivi infrastrutturali e burocratici non eludibili.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Cost Item 1 -->
        <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
          <div class="w-12 h-12 rounded-2xl bg-teal-100 dark:bg-teal-950/80 text-teal-600 dark:text-teal-400 flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
            Certificati Code Signing EV
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Per evitare che Microsoft SmartScreen mostri avvisi allarmanti ("Editore sconosciuto")
            quando gli artigiani avviano l'eseguibile, è obbligatorio acquistare certificati di
            firma digitale con token crittografico hardware (circa €400-600/anno).
          </p>
          <span class="text-xs font-semibold text-teal-600 dark:text-teal-400">
            Priorità: Massima
          </span>
        </div>

        <!-- Cost Item 2 -->
        <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
          <div class="w-12 h-12 rounded-2xl bg-cyan-100 dark:bg-cyan-950/80 text-cyan-600 dark:text-cyan-400 flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
            Infrastruttura CI/CD & Build Matrix
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            I test automatici e le build su macchine virtuali Windows e Linux, i controlli di
            qualità statica SonarQube / Qodana e i test di compatibilità richiedono runner dedicati
            e risorse cloud continuative.
          </p>
          <span class="text-xs font-semibold text-cyan-600 dark:text-cyan-400">Priorità: Alta</span>
        </div>

        <!-- Cost Item 3 -->
        <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 flex items-center justify-center mb-6">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-2">
            Ambienti di Test Fiscale (SDI & SIX)
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
            Caselle PEC certificate per collaudi, credenziali di accreditamento e validatori
            ufficiali dei canali bancari svizzeri per verificare la perfetta conformità delle
            fatture QR e dei flussi XML prima del rilascio pubblico.
          </p>
          <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            Priorità: Continuativa
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sponsorship Tiers Section -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900/50 border-t border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          Piani di Sostegno & Riconoscimento
        </h2>
        <p class="mt-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">
          Ogni contributo viene rendicontato pubblicamente sul nostro repository GitHub.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Tier 1: Micro Donatore -->
        <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400 mb-2">
              Artigiano o Professionista
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
              Micro Sostenitore
            </h3>
            <div class="text-3xl font-black text-slate-900 dark:text-white mb-4">
              5 - 25 <span class="text-sm font-normal text-slate-500">€/mese o una tantum</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
              Ideale per singoli elettricisti, idraulici o consulenti che risparmiano centinaia di
              euro all'anno evitando abbonamenti SaaS.
            </p>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500">✓</span> Menzione nella lista Supporter su GitHub
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500">✓</span> Badge Supporter nel canale Telegram della
                community
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500">✓</span> La nostra eterna gratitudine
              </li>
            </ul>
          </div>
          <div class="mt-8">
            <a
              href="https://github.com/sponsors/FatturaFacile"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-bold rounded-xl text-xs transition-colors"
            >
              Dona su GitHub Sponsors / Ko-fi
            </a>
          </div>
        </div>

        <!-- Tier 2: Partner Tecnologico -->
        <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border-2 border-teal-500 shadow-xl flex flex-col justify-between relative">
          <div class="absolute -top-3 right-6 bg-teal-600 text-white text-[10px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-full">
            Consigliato
          </div>
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400 mb-2">
              Studi & PMI IT
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
              Partner Tecnologico
            </h3>
            <div class="text-3xl font-black text-slate-900 dark:text-white mb-4">
              50 - 150 <span class="text-sm font-normal text-slate-500">€/mese</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
              Per fiduciarie, system integrator o software house che offrono supporto a clienti su
              Fattura Facile.
            </p>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-teal-500 font-bold">✓</span> Logo e backlink sul sito ufficiale
                fatturafacile.eu
              </li>
              <li class="flex items-center gap-2">
                <span class="text-teal-500 font-bold">✓</span> Badge "Sponsor Tecnico Verificato"
                nella directory
              </li>
              <li class="flex items-center gap-2">
                <span class="text-teal-500 font-bold">✓</span> Canale prioritario per segnalazione
                bug o requisiti
              </li>
            </ul>
          </div>
          <div class="mt-8">
            <a
              href="mailto:sponsor@fatturafacile.eu?subject=[Sponsor%20Tecnologico]"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded-xl text-xs shadow-md transition-colors"
            >
              Diventa Partner Tecnologico
            </a>
          </div>
        </div>

        <!-- Tier 3: Corporate & Istituzionale -->
        <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-md flex flex-col justify-between">
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">
              Banche, Camere & Aziende
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">Main Sponsor</h3>
            <div class="text-3xl font-black text-slate-900 dark:text-white mb-4">
              Annuale <span class="text-sm font-normal text-slate-500">personalizzato</span>
            </div>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mb-6 leading-relaxed">
              Per istituti bancari, associazioni di categoria o grandi aziende interessate a
              promuovere la digitalizzazione sobria e aperta.
            </p>
            <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800 pt-4">
              <li class="flex items-center gap-2">
                <span class="text-emerald-500">✓</span> Logo principale in homepage e in tutte le
                release note
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500">✓</span> Riconoscimento speciale nel README di GitHub
              </li>
              <li class="flex items-center gap-2">
                <span class="text-emerald-500">✓</span> Possibilità di co-organizzare eventi o
                webinar didattici
              </li>
            </ul>
          </div>
          <div class="mt-8">
            <a
              href="mailto:sponsor@fatturafacile.eu?subject=[Main%20Sponsorship]"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 bg-slate-900 dark:bg-slate-800 hover:bg-slate-800 dark:hover:bg-slate-700 text-white font-bold rounded-xl text-xs transition-colors"
            >
              Contatta per Sponsorship
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

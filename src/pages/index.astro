---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { DEMO_URL, GITHUB_ORG_URL, ROADMAP_URL, TELEGRAM_URL } from '../data/links';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h = t.home;

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://fatturafacile.eu/#website',
  name: t.common.siteName,
  alternateName: 'FatturaFacile Open Source ERP & Fatturazione (Svizzera QR-Bill & Italia SdI)',
  inLanguage: lang,
  description: h.seo.description,
  url: `https://fatturafacile.eu${getLocalizedPath('/', lang)}`,
  publisher: {
    '@id': 'https://fatturafacile.eu/#organization',
  },
};

// Icons for the four pillars, in the same order as t.home.pillars.
const pillarIcons = [
  {
    path: 'M5 13l4 4L19 7',
    box: 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-400',
  },
  {
    path: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    box: 'bg-teal-50 dark:bg-teal-950/60 text-teal-700 dark:text-teal-400',
  },
  {
    path: 'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
    box: 'bg-cyan-50 dark:bg-cyan-950/60 text-cyan-700 dark:text-cyan-400',
  },
  {
    path: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
    box: 'bg-slate-100 dark:bg-slate-700/60 text-slate-700 dark:text-slate-300',
  },
];

const featureIcons = [
  'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  'M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z',
];

// Only the web platform is released; the order matches t.home.platforms.items.
const platformAvailable = [true, false, false];
---

<BaseLayout
  title={h.seo.title}
  description={h.seo.description}
  keywords={h.seo.keywords}
  lang={lang}
  schema={webSiteSchema}
>
  <!-- Hero Section -->
  <section
    id="hero"
    class="relative overflow-hidden pt-12 pb-20 lg:pt-20 lg:pb-32 bg-gradient-to-b from-slate-100/70 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/60 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          <span>{h.hero.badgeGeo}</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800/60">
          <span>{h.hero.badgePrivacy}</span>
        </span>
      </div>

      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
          <span>{h.hero.titlePart1}</span>
          <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-700 to-emerald-700 dark:from-teal-400 dark:to-emerald-400">
            {h.hero.titlePart2}
          </span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto font-normal leading-relaxed">
          {h.hero.subtitle}
        </p>

        <!-- CTA Buttons: demo, GitHub, Telegram community -->
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={DEMO_URL}
            target="_blank"
            rel="noopener"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 text-base font-bold text-white bg-slate-900 dark:bg-teal-700 hover:bg-slate-800 dark:hover:bg-teal-800 rounded-2xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200"
          >
            <svg
              class="w-5 h-5 text-teal-400 dark:text-slate-950"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664zM21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              ></path>
            </svg>
            <span>{h.hero.ctaPrimary}</span>
          </a>

          <a
            href={GITHUB_ORG_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-base font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 rounded-2xl shadow-sm hover:shadow transition-all duration-200"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              ></path>
            </svg>
            <span>{h.hero.ctaSecondary}</span>
          </a>

          <a
            href={TELEGRAM_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 text-base font-semibold text-teal-800 dark:text-teal-300 bg-teal-50 dark:bg-teal-950/70 hover:bg-teal-100 dark:hover:bg-teal-900/80 border border-teal-200 dark:border-teal-800 rounded-2xl shadow-sm transition-all duration-200"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"></path>
            </svg>
            <span>{h.hero.ctaCommunity}</span>
          </a>
        </div>

        <!-- Pillar highlights -->
        <ul class="mt-12 grid grid-cols-2 md:grid-cols-4 gap-4 text-left">
          {h.pillars.map((pillar, i) => (
            <li class="p-4 bg-white dark:bg-slate-800/80 rounded-2xl border border-slate-200/70 dark:border-slate-700 shadow-sm flex items-start gap-3">
              <div class={`p-2 rounded-xl shrink-0 ${pillarIcons[i]?.box ?? ''}`}>
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d={pillarIcons[i]?.path}
                  />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-900 dark:text-white uppercase">
                  {pillar.title}
                </p>
                <p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5">{pillar.desc}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="py-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
          {h.philosophy.badge}
        </p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
          {h.philosophy.heading}
        </h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">{h.philosophy.lead}</p>
      </div>

      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
        {h.philosophy.features.map((feature, i) => (
          <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700 hover:border-teal-500/50 hover:shadow-lg transition-all duration-300">
            <div class="w-12 h-12 rounded-2xl bg-teal-700 text-white flex items-center justify-center mb-6 shadow-md shadow-teal-700/20">
              <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={featureIcons[i]}
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">{feature.title}</h3>
            <p class="mt-3 text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
              {feature.desc}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <a
          href={getLocalizedPath('/perche/', lang)}
          class="inline-flex items-center gap-2 text-sm font-bold text-teal-700 dark:text-teal-400 hover:underline"
        >
          {h.philosophy.more} &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="py-20 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
          {h.platforms.badge}
        </p>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 dark:text-white">
          {h.platforms.heading}
        </h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">{h.platforms.lead}</p>
      </div>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
        {h.platforms.items.map((platform, i) => (
          <div class="p-6 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex flex-col">
            <div class="flex items-center justify-between gap-3">
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{platform.name}</h3>
              {platformAvailable[i] ? (
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300">
                  {h.platforms.available}
                </span>
              ) : (
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 dark:bg-amber-950/70 text-amber-900 dark:text-amber-300">
                  {h.platforms.inDevelopment}
                </span>
              )}
            </div>
            <p class="mt-1 text-xs font-mono text-slate-600 dark:text-slate-400">
              {platform.stack}
            </p>
            <p class="mt-4 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {platform.desc}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={getLocalizedPath('/versioni/', lang)}
          class="px-6 py-3.5 bg-slate-900 dark:bg-teal-700 hover:bg-slate-800 dark:hover:bg-teal-800 text-white font-bold rounded-2xl transition-all shadow-sm"
        >
          {h.platforms.compareCta} &rarr;
        </a>
        <a
          href={getLocalizedPath('/moduli/', lang)}
          class="px-6 py-3.5 bg-white dark:bg-slate-900 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-300 dark:border-slate-700 text-slate-800 dark:text-slate-200 font-bold rounded-2xl transition-all"
        >
          {h.platforms.modulesCta} &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Coming Soon -->
  <section
    id="coming-soon"
    class="py-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 dark:bg-amber-950/70 text-amber-900 dark:text-amber-300">
          {h.comingSoon.badge}
        </span>
        <h2 class="mt-3 text-3xl font-extrabold text-slate-900 dark:text-white">
          {h.comingSoon.heading}
        </h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">{h.comingSoon.lead}</p>
      </div>

      <ul class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {h.comingSoon.items.map((item) => (
          <li class="p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-dashed border-slate-300 dark:border-slate-600">
            <h3 class="font-bold text-slate-900 dark:text-white">{item.title}</h3>
            <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.desc}
            </p>
          </li>
        ))}
      </ul>

      <div class="mt-10 text-center">
        <a
          href={ROADMAP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-bold text-teal-700 dark:text-teal-400 hover:underline"
        >
          {h.comingSoon.cta} &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- National Support & Schools -->
  <section class="py-16 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {[
          { block: h.territory.local, href: '/supporto-locale/', dot: 'bg-emerald-500' },
          { block: h.territory.schools, href: '/scuole-e-sociale/', dot: 'bg-teal-500' },
        ].map(({ block, href, dot }) => (
          <div class="p-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 mb-4">
                <span class={`w-2 h-2 rounded-full ${dot}`} />
                {block.badge}
              </div>
              <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{block.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                {block.desc}
              </p>
            </div>
            <div>
              <a
                href={getLocalizedPath(href, lang)}
                class="inline-flex items-center gap-2 text-sm font-bold text-teal-700 dark:text-teal-400 hover:underline"
              >
                <span>{block.cta}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo call to action -->
  <section
    id="demo"
    class="py-20 bg-slate-900 text-white relative overflow-hidden border-t border-slate-800"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <span class="px-4 py-1.5 rounded-full text-xs font-bold bg-teal-500/20 text-teal-300 border border-teal-500/30">
        {h.demoCta.badge}
      </span>
      <h2 class="mt-4 text-3xl sm:text-5xl font-black tracking-tight">{h.demoCta.title}</h2>
      <p class="mt-4 text-slate-300 max-w-2xl mx-auto">{h.demoCta.lead}</p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={DEMO_URL}
          target="_blank"
          rel="noopener"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 bg-teal-500 hover:bg-teal-400 text-slate-950 font-extrabold rounded-2xl shadow-xl transition-all"
        >
          {h.demoCta.primary}
        </a>
        <a
          href={getLocalizedPath('/contribuisci/', lang)}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold rounded-2xl transition-colors"
        >
          {h.demoCta.secondary}
        </a>
      </div>

      <ul class="mt-8 text-xs text-slate-300 flex flex-wrap justify-center gap-6">
        {h.demoCta.notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

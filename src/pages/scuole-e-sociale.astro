---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SCHOOLS_DATA, SCHOOL_TYPE_STYLES } from '../data/schools';
import type { SchoolIdKey } from '../i18n/types';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const sc = t.scuoleSociale;
const pageUrl = `https://fatturafacile.eu${getLocalizedPath('/scuole-e-sociale/', lang)}`;

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'EducationalOrganization',
      '@id': 'https://fatturafacile.eu/scuole-e-sociale/#organization',
      name: 'FatturaFacile Open Educational & Social Initiative',
      url: pageUrl,
      description: sc.schema.orgDescription,
      sameAs: ['https://github.com/FatturaFacile'],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        description: sc.schema.offerDescription,
      },
    },
    {
      '@type': 'Course',
      '@id': 'https://fatturafacile.eu/scuole-e-sociale/#track-technical',
      name: sc.schema.technicalName,
      description: sc.schema.technicalDescription,
      provider: {
        '@id': 'https://fatturafacile.eu/scuole-e-sociale/#organization',
      },
      isAccessibleForFree: true,
    },
    {
      '@type': 'Course',
      '@id': 'https://fatturafacile.eu/scuole-e-sociale/#track-commercial',
      name: sc.schema.commercialName,
      description: sc.schema.commercialDescription,
      provider: {
        '@id': 'https://fatturafacile.eu/scuole-e-sociale/#organization',
      },
      isAccessibleForFree: true,
    },
    ...SCHOOLS_DATA.map((school) => ({
      '@type': 'EducationalOrganization',
      '@id': `https://fatturafacile.eu/scuole-e-sociale/#${school.id}`,
      name: school.name,
      address: {
        '@type': 'PostalAddress',
        addressLocality: school.location.city,
        addressRegion: school.location.regionOrCanton,
        addressCountry: school.location.country,
      },
      ...(school.contact.website ? { url: school.contact.website } : {}),
      description: sc.schools.items[school.id as SchoolIdKey].description,
    })),
  ],
};

const mailtoSubject = encodeURIComponent('[Collaborazione Didattica] Nome Istituto');
const mailtoBody = encodeURIComponent(
  `${sc.contact.mailtoBody.join('\n')}\n\n---\n${sc.contact.mailtoFooter} ${pageUrl}`,
);
const mailtoLink = `mailto:scuole@fatturafacile.eu?subject=${mailtoSubject}&body=${mailtoBody}`;

// Style and link of the two tracks, in the same order as t.scuoleSociale.tracks.items.
const trackMeta = [
  {
    borderClass: 'border-teal-500/30',
    badgeClass:
      'bg-teal-100 dark:bg-teal-950 text-teal-800 dark:text-teal-300 border-teal-300 dark:border-teal-800',
    dotClass: 'bg-teal-500',
    linkHref: 'https://github.com/FatturaFacile',
    linkExternal: true,
    linkClass: 'text-teal-600 dark:text-teal-400',
  },
  {
    borderClass: 'border-emerald-500/30',
    badgeClass:
      'bg-emerald-100 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300 border-emerald-300 dark:border-emerald-800',
    dotClass: 'bg-emerald-500',
    linkHref: '#contatto-scuole',
    linkExternal: false,
    linkClass: 'text-emerald-600 dark:text-emerald-400',
  },
];

// Style and icon of the three social pillars, in the same order as t.scuoleSociale.mission.pillars.
const pillarMeta = [
  {
    iconWrapClass: 'bg-teal-100 dark:bg-teal-950/80 text-teal-600 dark:text-teal-400',
    iconPath: 'M13 10V3L4 14h7v7l9-11h-7z',
  },
  {
    iconWrapClass: 'bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400',
    iconPath:
      'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    iconWrapClass: 'bg-cyan-100 dark:bg-cyan-950/80 text-cyan-600 dark:text-cyan-400',
    iconPath:
      'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  },
];
---

<BaseLayout
  title={sc.seo.title}
  description={sc.seo.description}
  keywords={sc.seo.keywords}
  lang={lang}
  schema={schemaGraph}
>
  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden py-16 sm:py-24 bg-gradient-to-b from-teal-50/70 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/60 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <!-- Eyebrow Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800/60 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></span>
        {sc.hero.badge}
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight max-w-5xl mx-auto">
        {sc.hero.headingPre}
        <br class="hidden sm:inline" />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-emerald-600 dark:from-teal-400 dark:to-emerald-400">
          {sc.hero.headingHighlight}
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="mt-6 text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        {sc.hero.lead}
      </p>

      <!-- Quick Action CTAs -->
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="#contatto-scuole"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-sm sm:text-base font-bold text-white bg-teal-600 hover:bg-teal-500 dark:bg-teal-600 dark:hover:bg-teal-500 rounded-2xl shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all duration-200 cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
            ></path>
          </svg>
          <span>{sc.hero.ctaApply}</span>
        </a>

        <a
          href="https://github.com/FatturaFacile"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 text-sm sm:text-base font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 rounded-2xl shadow-sm hover:shadow transition-all duration-200"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span>{sc.hero.ctaGithub}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 2. Dual Educational Tracks (Two-Column Comparison Grid) -->
  <section class="py-16 sm:py-24 bg-white dark:bg-slate-950 border-b border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
          {sc.tracks.badge}
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {sc.tracks.title}
        </h2>
        <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300">{sc.tracks.lead}</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        {sc.tracks.items.map((track, ti) => (
          <div
            class={`flex flex-col justify-between bg-slate-50/80 dark:bg-slate-900/70 border-2 ${trackMeta[ti].borderClass} rounded-3xl p-8 sm:p-10 shadow-lg hover:shadow-xl transition-all`}
          >
            <div>
              <div class="flex items-center justify-between gap-4 mb-6">
                <span
                  class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border ${trackMeta[ti].badgeClass}`}
                >
                  {track.badge}
                </span>
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                  {track.schools}
                </span>
              </div>

              <h3 class="text-2xl font-black text-slate-900 dark:text-white mb-4">{track.title}</h3>
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-8">
                {track.description}
              </p>

              <div class="space-y-4">
                {track.items.map((item) => (
                  <div class="p-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700/80">
                    <div class="flex items-center gap-2 font-bold text-slate-900 dark:text-white text-sm mb-1">
                      <span class={`w-2 h-2 rounded-full ${trackMeta[ti].dotClass}`}></span>
                      {item.title}
                    </div>
                    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed pl-4">
                      {item.body}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-800">
              <a
                href={trackMeta[ti].linkHref}
                target={trackMeta[ti].linkExternal ? '_blank' : undefined}
                rel={trackMeta[ti].linkExternal ? 'noopener noreferrer' : undefined}
                class={`inline-flex items-center gap-2 text-sm font-bold ${trackMeta[ti].linkClass} hover:underline`}
              >
                <span>{track.linkText}</span>
                <span>&rarr;</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Participating Schools & Pilot Projects Showcase -->
  <section class="py-16 sm:py-24 bg-slate-50 dark:bg-slate-900/60 border-b border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
            {sc.schools.badge}
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-1">
            {sc.schools.title}
          </h2>
          <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">{sc.schools.lead}</p>
        </div>

        <!-- Filter Pills for Switzerland & Italy -->
        <div class="flex items-center gap-2 p-1.5 rounded-2xl bg-slate-200 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 shrink-0">
          <button
            type="button"
            class="school-filter-btn px-4 py-1.5 rounded-xl text-xs font-bold transition-all bg-white dark:bg-teal-600 text-slate-900 dark:text-white shadow-sm cursor-pointer"
            data-filter="ALL"
          >
            {sc.schools.filterAll}
          </button>
          <button
            type="button"
            class="school-filter-btn px-4 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white cursor-pointer"
            data-filter="CH"
          >
            🇨🇭 {sc.schools.filterCH}
          </button>
          <button
            type="button"
            class="school-filter-btn px-4 py-1.5 rounded-xl text-xs font-bold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white cursor-pointer"
            data-filter="IT"
          >
            🇮🇹 {sc.schools.filterIT}
          </button>
        </div>
      </div>

      <!-- Schools Grid -->
      <div id="schools-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {SCHOOLS_DATA.map((school) => {
          const schoolText = sc.schools.items[school.id as SchoolIdKey];
          return (
            <article
              id={school.id}
              class="school-card flex flex-col justify-between bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 hover:shadow-xl transition-all duration-200"
              data-country={school.location.country}
            >
              <div>
                <!-- Header: Name, Country Badge, School Type -->
                <div class="flex items-start justify-between gap-4 mb-4">
                  <div>
                    <span
                      class={`inline-block px-2.5 py-0.5 rounded-full text-[11px] font-bold border mb-2 ${SCHOOL_TYPE_STYLES[school.type]}`}
                    >
                      {sc.schools.types[school.type]}
                    </span>
                    <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-snug">
                      {school.name}
                    </h3>
                    <div class="text-xs text-slate-500 dark:text-slate-400 mt-1 flex items-center gap-1.5">
                      <svg
                        class="w-3.5 h-3.5 text-slate-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                        ></path>
                      </svg>
                      <span>
                        {school.location.city} • {school.location.regionOrCanton}
                      </span>
                    </div>
                  </div>

                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-extrabold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 shrink-0">
                    {school.location.country === 'CH' ? '🇨🇭 CH' : '🇮🇹 IT'}
                  </span>
                </div>

                <!-- Description -->
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                  {schoolText.description}
                </p>

                <!-- Active Programs List -->
                <div class="mb-6">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                    {sc.schools.programsLabel}
                  </div>
                  <div class="flex flex-wrap gap-2">
                    {school.programs.map((programKey) => {
                      const progMeta = sc.schools.programs[programKey];
                      return (
                        <span
                          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800/80"
                          title={progMeta.summary}
                        >
                          <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
                          {progMeta.label}
                        </span>
                      );
                    })}
                  </div>
                </div>
              </div>

              <!-- Footer: Academic Program & Website Link -->
              <div class="pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
                <div class="flex items-center gap-2 text-slate-600 dark:text-slate-400">
                  <svg
                    class="w-4 h-4 text-teal-600 dark:text-teal-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                    ></path>
                  </svg>
                  <span>
                    <strong class="text-slate-900 dark:text-white font-bold">
                      {schoolText.department}
                    </strong>
                  </span>
                </div>

                {school.contact.website && (
                  <a
                    href={school.contact.website}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-teal-600 dark:text-teal-400 font-bold hover:underline flex items-center gap-1"
                  >
                    <span>{sc.schools.website}</span>
                    <span>&rarr;</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 4. Social Mission & Digital Inclusion Pillars -->
  <section class="py-16 sm:py-24 bg-white dark:bg-slate-950 border-b border-slate-200/80 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
          {sc.mission.badge}
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          {sc.mission.title}
        </h2>
        <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300">
          {sc.mission.lead}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {sc.mission.pillars.map((pillar, pi) => (
          <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800">
            <div
              class={`w-12 h-12 rounded-2xl ${pillarMeta[pi].iconWrapClass} flex items-center justify-center font-bold mb-6`}
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d={pillarMeta[pi].iconPath}
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{pillar.title}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Teacher Onboarding & Application Section (#contatto-scuole) -->
  <section id="contatto-scuole" class="py-16 sm:py-24 bg-slate-50 dark:bg-slate-900 scroll-mt-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 shadow-xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950 text-teal-700 dark:text-teal-300 border border-teal-200 dark:border-teal-800 mb-4">
          <span class="w-2 h-2 rounded-full bg-teal-500"></span>
          {sc.contact.badge}
        </div>

        <h3 class="text-2xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-4">
          {sc.contact.title}
        </h3>
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-8 max-w-2xl mx-auto">
          {sc.contact.lead}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={mailtoLink}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded-2xl text-sm sm:text-base shadow-lg hover:shadow-xl transition-all cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <span>{sc.contact.emailBtn}</span>
          </a>

          <a
            href="https://t.me/+sRauQINBDFQ5NjU0"
            target="_blank"
            rel="noopener noreferrer"

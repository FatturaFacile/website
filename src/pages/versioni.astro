---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: t.versioni.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/versioni/', lang)}`,
  inLanguage: lang,
  description: t.versioni.seo.description,
  publisher: {
    '@type': 'Organization',
    name: 'Fattura Facile Teams',
  },
};
---

<BaseLayout
  title={t.versioni.seo.title}
  description={t.versioni.seo.description}
  keywords={t.versioni.seo.keywords}
  lang={lang}
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 dark:bg-teal-950/70 text-teal-800 dark:text-teal-300 mb-6">
        {t.versioni.eyebrow}
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {t.versioni.heading}
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed">
        {t.versioni.lead}
      </p>
    </div>
  </section>

  <!-- Side by Side Comparative Analysis -->
  <section class="py-20 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        <!-- Standalone Desktop Box -->
        <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 sm:p-10 border-2 border-emerald-500/40 dark:border-emerald-500/30 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between flex-wrap gap-2">
              <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-slate-200 uppercase">
                {t.versioni.desktopCard.tag}
              </span>
              <span class="text-emerald-600 dark:text-emerald-400 font-bold text-xs bg-emerald-50 dark:bg-emerald-950/50 px-3 py-1 rounded-full border border-emerald-200 dark:border-emerald-800/40">
                {t.versioni.desktopCard.badge}
              </span>
            </div>
            <h2 class="mt-4 text-2xl font-black text-slate-900 dark:text-white">
              {t.versioni.desktopCard.title}
            </h2>
            <p class="mt-2 text-slate-600 dark:text-slate-300 text-sm">
              {t.versioni.desktopCard.subtitle}
            </p>

            <ul class="mt-8 space-y-4 text-sm text-slate-700 dark:text-slate-300">
              {t.versioni.desktopCard.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M5 13l4 4L19 7"
                    ></path>
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-slate-400 shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
                <span class="text-slate-500 dark:text-slate-400">
                  {t.versioni.desktopCard.limitation}
                </span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800">
            <a
              href="https://github.com/FatturaFacile/desktop/releases"
              target="_blank"
              rel="noopener noreferrer"
              title={t.versioni.desktopCard.cta}
              aria-label={t.versioni.desktopCard.cta}
              class="w-full inline-flex items-center justify-center py-3.5 px-6 rounded-xl font-bold text-white bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-500 dark:hover:bg-emerald-600 shadow-md shadow-emerald-600/20 transition-colors"
            >
              {t.versioni.desktopCard.cta}
            </a>
          </div>
        </div>

        <!-- Cloud Self-Hosted Box -->
        <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-8 sm:p-10 border-2 border-slate-700 shadow-xl flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-12 -top-12 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
          <div>
            <div class="flex items-center justify-between flex-wrap gap-2">
              <span class="px-3.5 py-1 rounded-full text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-400/30 uppercase">
                {t.versioni.cloudCard.tag}
              </span>
              <span class="text-teal-300 font-bold text-xs bg-teal-950/60 px-3 py-1 rounded-full border border-teal-500/30">
                {t.versioni.cloudCard.badge}
              </span>
            </div>
            <h2 class="mt-4 text-2xl font-black text-white">{t.versioni.cloudCard.title}</h2>
            <p class="mt-2 text-slate-300 text-sm">{t.versioni.cloudCard.subtitle}</p>

            <ul class="mt-8 space-y-4 text-sm text-slate-200">
              {t.versioni.cloudCard.features.map((feature) => (
                <li class="flex items-start gap-3">
                  <svg
                    class="w-5 h-5 text-teal-400 shrink-0 mt-0.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2.5"
                      d="M5 13l4 4L19 7"
                    ></path>
                  </svg>
                  <span>{feature}</span>
                </li>
              ))}
              <li class="flex items-start gap-3">
                <svg
                  class="w-5 h-5 text-amber-400 shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
                <span class="text-amber-200/90 text-xs">{t.versioni.cloudCard.migrationNote}</span>
              </li>
            </ul>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-700">
            <a
              href="https://github.com/FatturaFacile"
              target="_blank"
              rel="noopener noreferrer"
              title={t.versioni.cloudCard.cta}
              aria-label={t.versioni.cloudCard.cta}
              class="w-full inline-flex items-center justify-center py-3.5 px-6 rounded-xl font-bold text-slate-900 bg-teal-400 hover:bg-teal-300 transition-colors"
            >
              {t.versioni.cloudCard.cta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Feature Comparison Table -->
  <section class="py-16 bg-white dark:bg-slate-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-2xl font-bold text-slate-900 dark:text-white text-center mb-8">
        {t.versioni.comparisonTable.title}
      </h3>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse border border-slate-200 dark:border-slate-800">
          <thead>
            <tr class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white">
              {t.versioni.comparisonTable.headers.map((header) => (
                <th class="p-4 border border-slate-200 dark:border-slate-700">{header}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
            {t.versioni.comparisonTable.rows.map((row) => (
              <tr>
                <td class="p-4 font-semibold">{row.feature}</td>
                <td class="p-4">{row.desktop}</td>
                <td class="p-4">{row.cloud}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

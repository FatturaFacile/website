---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  MODULES_DATA,
  MODULE_STATUS_META,
  MARKET_SCOPE_LABELS,
  type ModuleItem,
} from '../data/modules';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const m = t.moduli;

const availableModules: ModuleItem[] = MODULES_DATA.filter((item) => item.status === 'available');
const roadmapModules: ModuleItem[] = MODULES_DATA.filter((item) => item.status !== 'available');

const modulesSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: m.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/moduli/', lang)}`,
  inLanguage: lang,
  description: m.seo.description,
};
---

<BaseLayout
  title={m.seo.title}
  description={m.seo.description}
  keywords={m.seo.keywords}
  lang={lang}
  schema={modulesSchema}
>
  <section class="py-16 sm:py-20 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/60 dark:border-slate-800">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200 dark:border-teal-800/60 mb-6">
        <span class="w-2 h-2 rounded-full bg-teal-500"></span>
        {m.eyebrow}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {m.heading}
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        {m.lead}
      </p>
    </div>
  </section>

  <!-- Available Modules -->
  <section class="py-16 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-10">
        {m.availableSectionTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {availableModules.map((mod) => {
          const statusMeta = MODULE_STATUS_META[mod.status];
          const marketMeta = MARKET_SCOPE_LABELS[mod.market];
          return (
            <div
              id={mod.id}
              class="flex flex-col justify-between bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 hover:shadow-xl transition-all"
            >
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                  <span
                    class={`px-2.5 py-1 rounded-full text-xs font-bold border ${statusMeta.badgeClass}`}
                  >
                    {statusMeta.label} {mod.version ? `• ${mod.version}` : ''}
                  </span>
                  <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                    {marketMeta.flag} {marketMeta.label}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{mod.title}</h3>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                  {mod.description}
                </p>
              </div>
              <ul class="space-y-2 border-t border-slate-200 dark:border-slate-800 pt-4 text-xs text-slate-600 dark:text-slate-400">
                {mod.features.map((f) => (
                  <li class="flex items-center gap-2">
                    <span class="text-teal-600 dark:text-teal-400 font-bold">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Roadmap Modules -->
  <section id="roadmap" class="py-16 bg-slate-50 dark:bg-slate-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-10">
        {m.roadmapSectionTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {roadmapModules.map((mod) => {
          const statusMeta = MODULE_STATUS_META[mod.status];
          const marketMeta = MARKET_SCOPE_LABELS[mod.market];
          return (
            <div
              id={mod.id}
              class="flex flex-col justify-between bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8"
            >
              <div>
                <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                  <span
                    class={`px-2.5 py-1 rounded-full text-xs font-bold border ${statusMeta.badgeClass}`}
                  >
                    {statusMeta.label} {mod.plannedMilestone ? `• ${mod.plannedMilestone}` : ''}
                  </span>
                  <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
                    {marketMeta.flag} {marketMeta.label}
                  </span>
                </div>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{mod.title}</h3>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                  {mod.description}
                </p>
              </div>
              <ul class="space-y-2 border-t border-slate-200 dark:border-slate-800 pt-4 text-xs text-slate-600 dark:text-slate-400">
                {mod.features.map((f) => (
                  <li class="flex items-center gap-2">
                    <span class="text-teal-600 dark:text-teal-400 font-bold">•</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>

      <div class="mt-16 text-center">
        <a
          href={getLocalizedPath('/community-richieste/', lang)}
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded-xl text-sm shadow-md transition-all"
        >
          {t.common.actions.requestModule} &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import {
  CODE_OF_CONDUCT_URL,
  GITHUB_ORG_URL,
  GOOD_FIRST_ISSUES_URL,
  ROADMAP_URL,
  SECURITY_URL,
  TELEGRAM_URL,
  WIKI_CONTRIBUTING_URL,
} from '../data/links';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.contribute;

// Same order as t.contribute.repos.items.
const repos = [
  { name: 'web-api', stack: 'Laravel · PHP · PostgreSQL' },
  { name: 'web-frontend', stack: 'Angular · TypeScript' },
  { name: 'desktop', stack: '.NET · WPF · SQLite' },
  { name: 'mobile', stack: 'Flutter · Dart' },
  { name: 'website', stack: 'Astro · Tailwind CSS' },
  { name: 'FatturaFacile', stack: 'Wiki · GitHub Actions' },
];

const resources = [
  { label: c.resources.guide, href: WIKI_CONTRIBUTING_URL },
  { label: c.resources.codeOfConduct, href: CODE_OF_CONDUCT_URL },
  { label: c.resources.security, href: SECURITY_URL },
  { label: c.resources.roadmap, href: ROADMAP_URL },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: c.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath('/contribuisci/', lang)}`,
  inLanguage: lang,
  description: c.seo.description,
};
---

<BaseLayout
  title={c.seo.title}
  description={c.seo.description}
  keywords={c.seo.keywords}
  lang={lang}
  schema={pageSchema}
>
  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 dark:bg-teal-950/70 text-teal-800 dark:text-teal-300 mb-6">
        {c.eyebrow}
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {c.heading}
      </h1>
      <p class="mt-6 text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-3xl mx-auto">
        {c.lead}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={TELEGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 text-base font-bold text-white bg-slate-900 dark:bg-teal-700 hover:bg-slate-800 dark:hover:bg-teal-800 rounded-2xl shadow-lg transition-all"
        >
          {c.ctaTelegram}
        </a>
        <a
          href={GOOD_FIRST_ISSUES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-4 text-base font-semibold text-slate-700 dark:text-slate-200 bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-700 border border-slate-300 dark:border-slate-700 rounded-2xl shadow-sm transition-all"
        >
          {c.ctaIssues}
        </a>
      </div>
    </div>
  </section>

  <!-- Ways to help -->
  <section class="py-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
          {c.ways.badge}
        </p>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 dark:text-white">{c.ways.title}</h2>
      </div>
      <ul class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {c.ways.items.map((item) => (
          <li class="p-6 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">{item.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.desc}
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Workflow -->
  <section class="py-20 bg-slate-50 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
          {c.flow.badge}
        </p>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 dark:text-white">{c.flow.title}</h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">{c.flow.lead}</p>
      </div>
      <ol class="mt-12 space-y-4">
        {c.flow.steps.map((step, i) => (
          <li class="flex gap-4 p-5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700">
            <span class="shrink-0 w-9 h-9 rounded-full bg-teal-700 text-white font-bold flex items-center justify-center">
              {i + 1}
            </span>
            <div>
              <h3 class="font-bold text-slate-900 dark:text-white">{step.title}</h3>
              <p class="mt-1 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                {step.desc}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Repositories -->
  <section class="py-20 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400">
          {c.repos.badge}
        </p>
        <h2 class="mt-2 text-3xl font-extrabold text-slate-900 dark:text-white">{c.repos.title}</h2>
      </div>
      <ul class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {repos.map((repo, i) => (
          <li>
            <a
              href={`${GITHUB_ORG_URL}/${repo.name}`}
              target="_blank"
              rel="noopener noreferrer"
              class="block h-full p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700 hover:border-teal-500/60 transition-colors"
            >
              <span class="font-mono font-bold text-teal-800 dark:text-teal-300">{repo.name}</span>
              <span class="block mt-1 text-xs text-slate-600 dark:text-slate-400">
                {repo.stack}
              </span>
              <span class="block mt-3 text-sm text-slate-700 dark:text-slate-300">
                {c.repos.items[i]?.desc}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Resources -->
  <section class="py-16 bg-slate-900 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl font-extrabold">{c.resources.title}</h2>
      <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
        {resources.map((r) => (
          <li>
            <a
              href={r.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between gap-3 p-4 rounded-2xl bg-slate-800 hover:bg-slate-700 border border-slate-700 font-semibold transition-colors"
            >
              <span>{r.label}</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

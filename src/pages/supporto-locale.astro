---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerApplicationForm from '../components/PartnerApplicationForm.astro';
import { PARTNERS_DATA, SERVICE_LABELS } from '../data/partners';

// LocalBusiness / ProfessionalService schema for local support providers
const partnersSchema = {
  '@context': 'https://schema.org',
  '@graph': PARTNERS_DATA.map((partner) => ({
    '@type': 'ProfessionalService',
    '@id': `https://fatturafacile.eu/supporto-locale/#${partner.id}`,
    name: partner.companyName,
    employee: {
      '@type': 'Person',
      name: partner.name,
      jobTitle: partner.role,
    },
    description: partner.description,
    address: {
      '@type': 'PostalAddress',
      addressLocality: partner.location.city,
      addressRegion: partner.location.regionOrCanton,
      postalCode: partner.location.postalCode,
      addressCountry: partner.location.country,
    },
    email: partner.contact.email,
    ...(partner.contact.phone ? { telephone: partner.contact.phone } : {}),
    ...(partner.contact.website ? { url: partner.contact.website } : {}),
    knowsAbout: partner.services.map((s) => SERVICE_LABELS[s].label),
  })),
};
---

<BaseLayout
  title="Supporto Locale & Partner Territoriali (Italia e Svizzera) | Fattura Facile"
  description="Trova tecnici IT, fiduciarie e sistemisti certificati per assistenza on-site, setup reti, backup e consulenza per Fattura Facile in Canton Ticino, Lombardia e Piemonte."
  schema={partnersSchema}
>
  <!-- Page Hero -->
  <section class="py-16 sm:py-20 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200/60 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Rete Territoriale Indipendente IT & CH
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Supporto Locale e sul Posto
        <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-600 to-emerald-600 dark:from-teal-400 dark:to-emerald-400">
          Vicino alla tua Attività
        </span>
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Fattura Facile è un software libero e 100% gratuito. Se desideri assistenza di persona in
        officina, configurazioni complesse su server aziendali o raccordo con la tua fiduciaria,
        puoi affidarti alla nostra rete di partner locali certificati.
      </p>
    </div>
  </section>

  <!-- Interactive Directory Section -->
  <section class="py-16 bg-white dark:bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filter Bar -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 mb-10">
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Filtra Nazione:
          </span>
          <div class="inline-flex rounded-xl bg-slate-200 dark:bg-slate-800 p-1">
            <button
              id="filter-all"
              class="partner-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white dark:bg-teal-600 text-slate-900 dark:text-white shadow-sm"
              data-country="ALL"
            >
              Tutti (IT & CH)
            </button>
            <button
              id="filter-ch"
              class="partner-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900"
              data-country="CH"
            >
              🇨🇭 Svizzera
            </button>
            <button
              id="filter-it"
              class="partner-filter-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all text-slate-600 dark:text-slate-300 hover:text-slate-900"
              data-country="IT"
            >
              🇮🇹 Italia
            </button>
          </div>
        </div>

        <div class="text-xs text-slate-500 dark:text-slate-400 flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
              clip-rule="evenodd"
            ></path>
          </svg>
          Partner verificati dalla community
        </div>
      </div>

      <!-- Partners Grid -->
      <div id="partners-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {PARTNERS_DATA.map((partner) => (
          <article
            id={partner.id}
            class="partner-card flex flex-col justify-between bg-slate-50/70 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 hover:shadow-xl transition-all duration-200"
            data-country={partner.location.country}
          >
            <div>
              <!-- Header Card -->
              <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-base font-bold text-slate-900 dark:text-white">
                      {partner.companyName}
                    </span>
                    {partner.verified && (
                      <span
                        class="inline-flex items-center text-teal-600 dark:text-teal-400"
                        title="Partner Verificato"
                      >
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                          <path
                            fill-rule="evenodd"
                            d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                            clip-rule="evenodd"
                          ></path>
                        </svg>
                      </span>
                    )}
                  </div>
                  <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                    Referente:{' '}
                    <span class="font-semibold text-slate-700 dark:text-slate-300">
                      {partner.name}
                    </span>{' '}
                    •{' '}
                    <span class="text-teal-600 dark:text-teal-400 font-semibold">
                      {partner.role}
                    </span>
                  </div>
                </div>

                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-300 shrink-0">
                  {partner.location.country === 'CH' ? '🇨🇭 CH' : '🇮🇹 IT'} - {partner.location.city}
                </span>
              </div>

              <!-- Location Details -->
              <p class="text-xs text-slate-500 dark:text-slate-400 mb-4 flex items-center gap-1.5">
                <svg
                  class="w-3.5 h-3.5 shrink-0 text-slate-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
                {partner.location.regionOrCanton} ({partner.location.city}
                {partner.location.postalCode ? `, ${partner.location.postalCode}` : ''})
              </p>

              <!-- Description -->
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                {partner.description}
              </p>

              <!-- Service Badges -->
              <div class="mb-6">
                <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">
                  Servizi & Competenze:
                </div>
                <div class="flex flex-wrap gap-2">
                  {partner.services.map((srv) => (
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-teal-50 dark:bg-teal-950/60 text-teal-800 dark:text-teal-300 border border-teal-200/80 dark:border-teal-800/80">
                      <span class="w-1.5 h-1.5 rounded-full bg-teal-500"></span>
                      {SERVICE_LABELS[srv].label}
                    </span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Contact Actions -->
            <div class="pt-6 border-t border-slate-200 dark:border-slate-800 flex flex-wrap items-center justify-between gap-3 text-xs">
              <div class="flex items-center gap-4">
                <a
                  href={`mailto:${partner.contact.email}`}
                  class="font-bold text-teal-600 dark:text-teal-400 hover:underline flex items-center gap-1"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    ></path>
                  </svg>
                  {partner.contact.email}
                </a>
                {partner.contact.phone && (
                  <span class="text-slate-500 dark:text-slate-400 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                      ></path>
                    </svg>
                    {partner.contact.phone}
                  </span>
                )}
              </div>

              {partner.contact.website && (
                <a
                  href={partner.contact.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors flex items-center gap-1"
                >
                  Sito Web &rarr;
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Partner Application Form Section -->
  <section
    id="candidatura"
    class="py-16 bg-slate-50 dark:bg-slate-900/50 border-t border-slate-200/80 dark:border-slate-800"
  >
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <PartnerApplicationForm />
    </div>
  </section>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.partner-filter-btn');
    const cards = document.querySelectorAll('.partner-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const country = btn.getAttribute('data-country');

        // Reset active style on buttons
        filterBtns.forEach((b) => {
          b.classList.remove(
            'bg-white',
            'dark:bg-teal-600',
            'text-slate-900',
            'dark:text-white',
            'shadow-sm',
          );
          b.classList.add('text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.remove('text-slate-600', 'dark:text-slate-300');
        btn.classList.add(
          'bg-white',
          'dark:bg-teal-600',
          'text-slate-900',
          'dark:text-white',
          'shadow-sm',
        );

        // Filter cards
        cards.forEach((card) => {
          const cardCountry = card.getAttribute('data-country');
          if (country === 'ALL' || cardCountry === country) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>

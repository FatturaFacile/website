---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamMemberCard from '../components/TeamMemberCard.astro';
import { TEAM_MEMBERS, type TeamMember } from '../data/team';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tm = t.team;

const regionalSections: Array<{ title: string; members: TeamMember[] }> = [
  {
    title: tm.regions.switzerland,
    members: TEAM_MEMBERS.filter((m) => m.location.country === 'CH'),
  },
  {
    title: tm.regions.italy,
    members: TEAM_MEMBERS.filter((m) => m.location.country === 'IT'),
  },
];

const teamSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AboutPage',
      '@id': `https://fatturafacile.eu${getLocalizedPath('/team/', lang)}#webpage`,
      name: tm.seo.title,
      url: `https://fatturafacile.eu${getLocalizedPath('/team/', lang)}`,
      inLanguage: lang,
      description: tm.seo.description,
    },
    ...TEAM_MEMBERS.map((member) => ({
      '@type': 'Person',
      '@id': `https://fatturafacile.eu/team/#${member.id}`,
      name: member.name,
      jobTitle: member.role,
      description: member.bio,
      workLocation: {
        '@type': 'Place',
        name: `${member.location.city}, ${member.location.regionOrCanton} (${member.location.country})`,
      },
      worksFor: {
        '@type': 'Organization',
        name: 'Fattura Facile',
        url: 'https://fatturafacile.eu/',
      },
    })),
  ],
};
---

<BaseLayout
  title={tm.seo.title}
  description={tm.seo.description}
  keywords={tm.seo.keywords}
  lang={lang}
  schema={teamSchema}
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-24 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 dark:bg-teal-950/70 text-teal-800 dark:text-teal-300 mb-6">
        {tm.eyebrow}
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {tm.heading}
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed">
        {tm.lead}
      </p>
    </div>
  </section>

  <!-- Regional Team Grid -->
  <section class="py-16 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      {regionalSections.map((section) => (
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mb-8 flex items-center gap-3">
            <span>{section.title}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {section.members.map((member) => (
              <TeamMemberCard member={member} coreMaintainerBadge={tm.coreMaintainerBadge} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Join CTA -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold text-slate-900 dark:text-white">{tm.joinCta.title}</h2>
      <p class="mt-4 text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
        {tm.joinCta.description}
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://github.com/FatturaFacile"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 bg-slate-900 dark:bg-teal-600 hover:bg-slate-800 dark:hover:bg-teal-500 text-white font-bold rounded-xl text-sm transition-colors"
        >
          {tm.joinCta.githubBtn}
        </a>
        <a
          href="https://t.me/+sRauQINBDFQ5NjU0"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white font-bold rounded-xl text-sm hover:border-teal-500 transition-colors"
        >
          {tm.joinCta.telegramBtn}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

---
import StoriaPageView from '../../components/StoriaPageView.astro';
import type { Locale } from '../../i18n/types';
import { STORIA_ALTERNATES } from '../../i18n/storia';

export function getStaticPaths() {
  const locales: Locale[] = ['en', 'fr', 'de'];
  return locales.map((lang) => ({
    params: { lang },
    props: {
      lang,
      canonicalUrl: STORIA_ALTERNATES[lang],
    },
  }));
}

interface Props {
  lang: Locale;
  canonicalUrl: string;
}

const { lang, canonicalUrl } = Astro.props;
---

<StoriaPageView lang={lang} canonicalUrl={canonicalUrl} />

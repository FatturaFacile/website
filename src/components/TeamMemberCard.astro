---
import { TEAM_DOMAIN_LABELS, type TeamMember } from '../data/team';
import { getInitials } from '../utils/i18n-helper';

export interface Props {
  member: TeamMember;
  coreMaintainerBadge: string;
}

const { member, coreMaintainerBadge } = Astro.props;
---

<article
  id={member.id}
  class="p-6 sm:p-8 rounded-3xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 flex flex-col justify-between shadow-sm"
>
  <div>
    <div class="flex items-start justify-between gap-4 mb-4">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white font-black flex items-center justify-center text-base shrink-0">
          {getInitials(member.name)}
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white">{member.name}</h3>
          <p class="text-xs font-semibold text-teal-600 dark:text-teal-400">{member.role}</p>
          <p class="text-xs text-slate-500 dark:text-slate-400">
            {member.location.city} ({member.location.regionOrCanton}, {member.location.country})
          </p>
        </div>
      </div>
      {member.isCoreMaintainer && (
        <span class="px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 dark:bg-emerald-950/70 text-emerald-800 dark:text-emerald-300">
          {coreMaintainerBadge}
        </span>
      )}
    </div>

    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-5">{member.bio}</p>
  </div>

  <div class="flex flex-wrap gap-1.5 pt-4 border-t border-slate-200 dark:border-slate-800">
    {member.domains.map((domainKey) => {
      const dom = TEAM_DOMAIN_LABELS[domainKey];
      return (
        <span class={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border ${dom.badgeClass}`}>
          {dom.label}
        </span>
      );
    })}
  </div>
</article>

---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import type { ImageMetadata } from 'astro';
import type { TeamMember } from '../data/team';

export interface Props {
  member: TeamMember;
  coreMaintainerBadge: string;
}

const { member, coreMaintainerBadge } = Astro.props;

// Support local profile image in either src/assets/ or public/img/
const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/davide-nava.{webp,png,jpg,jpeg,avif}',
  { eager: true },
);
const firstAssetImage = Object.values(assetImages)[0]?.default?.src;

const publicImageCandidates = [
  member.avatarUrl,
  '/img/davide-nava.webp',
  '/img/team/davide-nava.webp',
  '/img/davide-nava.jpg',
  '/img/davide-nava.png',
].filter((p): p is string => Boolean(p));

const existingPublicImage = publicImageCandidates.find((relPath) => {
  try {
    const absPath = fileURLToPath(new URL(`../../public${relPath}`, import.meta.url));
    return existsSync(absPath);
  } catch {
    return false;
  }
});

const githubUsername = member.social.github
  ? member.social.github.replace(/\/+$/, '').split('/').pop()
  : 'davidenava';
const githubAvatarUrl = `https://github.com/${githubUsername}.png?size=240`;
const fallbackPlaceholderUrl = '/img/avatar-placeholder.svg';

const resolvedAvatarSrc = firstAssetImage ?? existingPublicImage ?? githubAvatarUrl;
const locationText = `${member.location.city}, ${member.location.regionOrCanton} (${member.location.country})`;
---

<article
  id={member.id}
  class="group relative w-full max-w-md mx-auto p-8 sm:p-10 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col items-center text-center"
>
  {member.isCoreMaintainer && (
    <span class="mb-5 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-emerald-100/90 dark:bg-emerald-950/80 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/60">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
      {coreMaintainerBadge}
    </span>
  )}

  <!-- Profile Photo (~110px circular with contrast border & safe fallback) -->
  <div class="relative mb-5">
    <div class="w-[110px] h-[110px] rounded-full p-1 bg-gradient-to-tr from-teal-600 to-emerald-500 dark:from-teal-500 dark:to-emerald-400 shadow-md">
      <img
        src={resolvedAvatarSrc}
        alt={`${member.name} – ${member.role}`}
        width="110"
        height="110"
        loading="lazy"
        decoding="async"
        data-fallback={fallbackPlaceholderUrl}
        onerror="if (this.src !== this.dataset.fallback) { this.src = this.dataset.fallback; }"
        class="w-full h-full rounded-full object-cover bg-slate-100 dark:bg-slate-800 border-2 border-white dark:border-slate-900"
      />
    </div>
  </div>

  <!-- Member Info -->
  <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white tracking-tight">
    {member.name}
  </h3>

  <p class="mt-1.5 text-sm font-bold text-teal-700 dark:text-teal-400">{member.role}</p>

  <p class="mt-2.5 inline-flex items-center justify-center gap-1.5 text-xs font-medium text-slate-500 dark:text-slate-400">
    <svg
      class="w-4 h-4 text-teal-700 dark:text-teal-400 shrink-0"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
      />
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
      />
    </svg>
    <span>{locationText}</span>
  </p>

  <!-- Action Row (Contact Buttons) -->
  <div class="mt-7 pt-6 border-t border-slate-200/80 dark:border-slate-800 w-full flex flex-wrap items-center justify-center gap-2.5">
    {member.social.linkedin && (
      <a
        href={member.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${member.name} LinkedIn`}
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800/90 hover:bg-teal-50 dark:hover:bg-teal-950/60 hover:text-teal-700 dark:hover:text-teal-300 border border-slate-200 dark:border-slate-700 hover:border-teal-400 dark:hover:border-teal-700 shadow-xs hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z" />
        </svg>
        <span>LinkedIn</span>
      </a>
    )}

    {member.social.github && (
      <a
        href={member.social.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${member.name} GitHub`}
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800/90 hover:bg-teal-50 dark:hover:bg-teal-950/60 hover:text-teal-700 dark:hover:text-teal-300 border border-slate-200 dark:border-slate-700 hover:border-teal-400 dark:hover:border-teal-700 shadow-xs hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200"
      >
        <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
          />
        </svg>
        <span>GitHub</span>
      </a>
    )}

    {member.social.email && (
      <a
        href={`mailto:${member.social.email}`}
        aria-label={`${member.name} Email`}
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800/90 hover:bg-teal-50 dark:hover:bg-teal-950/60 hover:text-teal-700 dark:hover:text-teal-300 border border-slate-200 dark:border-slate-700 hover:border-teal-400 dark:hover:border-teal-700 shadow-xs hover:shadow-sm hover:-translate-y-0.5 transition-all duration-200"
      >
        <svg
          class="w-4 h-4 shrink-0"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
          />
        </svg>
        <span>Email</span>
      </a>
    )}
  </div>
</article>

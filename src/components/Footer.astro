---
---

<footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800 text-sm mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-xl font-bold text-white tracking-tight">
            Fattura<span class="text-teal-400">Facile</span>
          </span>
        </div>
        <p class="text-xs font-semibold text-teal-400" data-i18n="logo_claim">
          Fatture semplici, offline e cloud
        </p>
        <p class="text-xs text-slate-400 leading-relaxed" data-i18n="foot_desc">
          Il sistema di fatturazione snello creato appositamente per artigiani e micro-imprese in
          Italia e Svizzera. Con architettura SQLite locale e opzione cloud self-hosted.
        </p>
        <div class="text-xs text-slate-300">
          <strong data-i18n="foot_email_label">Email di contatto:</strong>{' '}
          <a href="mailto:info@fatturafacile.eu" class="text-teal-400 hover:underline">
            info@fatturafacile.eu
          </a>
        </div>
      </div>

      <!-- Col 2: Product & Community -->
      <div>
        <h4
          class="text-white text-xs font-bold uppercase tracking-wider mb-4"
          data-i18n="foot_col_prod"
        >
          Prodotto & Community
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/perche/" class="hover:text-white transition-colors" data-i18n="nav_why">
              Perché Fattura Facile
            </a>
          </li>
          <li>
            <a href="/storia/" class="hover:text-white transition-colors">
              La Nostra Storia
            </a>
          </li>
          <li>
            <a href="/funzionalita/" class="hover:text-white transition-colors">
              Funzionalità & Moduli
            </a>
          </li>
          <li>
            <a
              href="/versioni/"
              class="hover:text-white transition-colors"
              data-i18n="nav_versions"
            >
              Desktop vs Cloud
            </a>
          </li>
          <li>
            <a
              href="/community-richieste/"
              class="hover:text-teal-400 transition-colors"
              data-i18n="nav_community"
            >
              Richiedi Moduli Gratis
            </a>
          </li>
          <li>
            <a href="/scuole-e-sociale/" class="hover:text-white transition-colors">
              Scuole & Sociale
            </a>
          </li>
          <li>
            <a href="/sponsor/" class="hover:text-white transition-colors">
              Sponsor & Sostenibilità
            </a>
          </li>
          <li>
            <a href="/supporto-locale/" class="hover:text-teal-400 transition-colors">
              Rete Partner Territoriali
            </a>
          </li>
          <li>
            <a
              href="https://t.me/+sRauQINBDFQ5NjU0"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              Community Telegram
            </a>
          </li>
          <li>
            <a
              href="https://github.com/FatturaFacile"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
              data-i18n="foot_github_repo"
            >
              Repository GitHub
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Compliance -->
      <div>
        <h4
          class="text-white text-xs font-bold uppercase tracking-wider mb-4"
          data-i18n="foot_col_legal"
        >
          Privacy & Normativa
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="/privacy/"
              class="hover:text-white transition-colors text-left block"
              data-i18n="foot_gdpr"
            >
              Conformità GDPR (UE 2016/679)
            </a>
          </li>
          <li>
            <a
              href="/privacy/"
              class="hover:text-white transition-colors text-left block"
              data-i18n="foot_nlpd"
            >
              Conformità nLPD Svizzera
            </a>
          </li>
          <li>
            <button
              onclick="window.openPrivacyModal()"
              class="hover:text-white transition-colors text-left cursor-pointer"
              data-i18n="foot_offline_priv"
            >
              Scheda Privacy & Architettura
            </button>
          </li>
          <li>
            <a
              href="https://github.com/FatturaFacile/FatturaFacile/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
              data-i18n="foot_license"
            >
              Licenza Software (MIT/Open)
            </a>
          </li>
          <li>
            <a href="/faq/" class="hover:text-white transition-colors">
              Domande Frequenti (FAQ)
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Regional Markets -->
      <div>
        <h4
          class="text-white text-xs font-bold uppercase tracking-wider mb-4"
          data-i18n="foot_col_geo"
        >
          Mercati Regionali
        </h4>
        <p class="text-xs text-slate-400 mb-2" data-i18n="foot_geo_it">
          <strong>Italia 🇮🇹:</strong> Compatibile con FatturaPA XML, tracciamento pagamenti e regimi
          forfettario/ordinario.
        </p>
        <p class="text-xs text-slate-400 mb-4" data-i18n="foot_geo_ch">
          <strong>Svizzera 🇨🇭:</strong> Compatibile con QR-Bill (standard SIX), calcolo aliquote IVA
          CH (standard, ridotta, speciale).
        </p>
        <div class="pt-3 border-t border-slate-900">
          <a
            href="/supporto-locale/"
            class="inline-flex items-center gap-1.5 text-xs text-teal-400 font-bold hover:underline"
          >
            <span>Trova supporto locale o fiduciaria</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        &copy; <span id="year-span">2026</span> Fattura Facile. Software libero rilasciato sotto
        licenza open source.
      </div>
      <div class="flex gap-4">
        <a href="/privacy/" class="hover:text-slate-300" data-i18n="foot_privacy_policy">
          Privacy Policy
        </a>
        <span>•</span>
        <a
          href="https://t.me/+sRauQINBDFQ5NjU0"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-300"
        >
          Telegram
        </a>
        <span>•</span>
        <a
          href="https://github.com/FatturaFacile"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-300"
        >
          GitHub
        </a>
        <span>•</span>
        <a href="https://fatturafacile.eu/" class="hover:text-slate-300">
          fatturafacile.eu
        </a>
      </div>
    </div>
  </div>
</footer>

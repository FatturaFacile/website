---
import type { Locale } from '../i18n/types';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

export interface Props {
  lang?: Locale;
}

const lang: Locale = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="bg-slate-950 text-slate-400 py-12 border-t border-slate-800 text-sm mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      <!-- Col 1: Brand -->
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-xl font-bold text-white tracking-tight">
            Fattura<span class="text-teal-400">Facile</span>
          </span>
        </div>
        <p class="text-xs font-semibold text-teal-400" data-i18n="logo_claim">
          {t.common.tagline}
        </p>
        <p class="text-xs text-slate-400 leading-relaxed" data-i18n="foot_desc">
          {t.common.footer.description}
        </p>
        <div class="text-xs text-slate-300">
          <strong data-i18n="foot_email_label">{t.common.footer.emailLabel}</strong>{' '}
          <a href="mailto:info@fatturafacile.eu" class="text-teal-400 hover:underline">
            info@fatturafacile.eu
          </a>
        </div>
      </div>

      <!-- Col 2: Product & Community -->
      <div>
        <h4
          class="text-white text-xs font-bold uppercase tracking-wider mb-4"
          data-i18n="foot_col_prod"
        >
          {t.common.footer.productColTitle}
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href={getLocalizedPath('/perche/', lang)}
              class="hover:text-white transition-colors"
              data-i18n="nav_why"
            >
              {t.common.nav.whyUs}
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/storia/', lang)} class="hover:text-white transition-colors">
              {t.common.nav.story}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/funzionalita/', lang)}
              class="hover:text-white transition-colors"
            >
              {t.common.nav.featuresModules}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/versioni/', lang)}
              class="hover:text-white transition-colors"
              data-i18n="nav_versions"
            >
              {t.common.nav.offlineVsCloud}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/community/', lang)}
              class="hover:text-teal-400 transition-colors"
            >
              Community Open Source
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/community-richieste/', lang)}
              class="hover:text-teal-400 transition-colors"
              data-i18n="nav_community"
            >
              {t.common.nav.requestModulesFree}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/scuole-e-sociale/', lang)}
              class="hover:text-white transition-colors"
            >
              {t.common.nav.schoolsSocial}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/sponsor/', lang)}
              class="hover:text-white transition-colors"
            >
              {t.common.nav.sponsors}
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/supporto-locale/', lang)}
              class="hover:text-teal-400 transition-colors"
            >
              {t.common.nav.localSupport}
            </a>
          </li>
          <li>
            <a
              href="https://t.me/+sRauQINBDFQ5NjU0"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
            >
              {t.common.footer.telegramCommunity}
            </a>
          </li>
          <li>
            <a
              href="https://github.com/FatturaFacile"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
              data-i18n="foot_github_repo"
            >
              {t.common.footer.githubRepo}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Compliance -->
      <div>
        <h4
          class="text-white text-xs font-bold uppercase tracking-wider mb-4"
          data-i18n="foot_col_legal"
        >
          {t.common.footer.legalColTitle}
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href={getLocalizedPath('/privacy/', lang)}
              class="hover:text-white transition-colors text-left block"
              data-i18n="foot_gdpr"
            >
              GDPR (EU 2016/679)
            </a>
          </li>
          <li>
            <a
              href={getLocalizedPath('/privacy/', lang)}
              class="hover:text-white transition-colors text-left block"
              data-i18n="foot_nlpd"
            >
              Swiss FADP / nLPD
            </a>
          </li>
          <li>
            <button
              onclick="window.openPrivacyModal()"
              class="hover:text-white transition-colors text-left cursor-pointer"
              data-i18n="foot_offline_priv"
            >
              {t.common.privacyModal.title}
            </button>
          </li>
          <li>
            <a
              href="https://github.com/FatturaFacile/FatturaFacile/blob/main/LICENSE"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors"
              data-i18n="foot_license"
            >
              MIT / Open Source License
            </a>
          </li>
          <li>
            <a href={getLocalizedPath('/faq/', lang)} class="hover:text-white transition-colors">
              {t.common.nav.faq}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Regional Markets -->
      <div>
        <h4
          class="text-white text-xs font-bold uppercase tracking-wider mb-4"
          data-i18n="foot_col_geo"
        >
          {t.common.footer.marketsColTitle}
        </h4>
        <p class="text-xs text-slate-400 mb-2" data-i18n="foot_geo_it">
          {t.common.footer.italyMarketDesc}
        </p>
        <p class="text-xs text-slate-400 mb-4" data-i18n="foot_geo_ch">
          {t.common.footer.swissMarketDesc}
        </p>
        <div class="pt-3 border-t border-slate-900">
          <a
            href={getLocalizedPath('/supporto-locale/', lang)}
            class="inline-flex items-center gap-1.5 text-xs text-teal-400 font-bold hover:underline"
          >
            <span>{t.common.nav.localSupport}</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-900 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <div>
        &copy; <span id="year-span">2026</span> {t.common.footer.copyright}
      </div>
      <div class="flex gap-4">
        <a
          href={getLocalizedPath('/privacy/', lang)}
          class="hover:text-slate-300"
          data-i18n="foot_privacy_policy"
        >
          {t.common.nav.privacy}
        </a>
        <span>•</span>
        <a
          href="https://t.me/+sRauQINBDFQ5NjU0"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-300"
        >
          Telegram
        </a>
        <span>•</span>
        <a
          href="https://github.com/FatturaFacile"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-slate-300"
        >
          GitHub
        </a>
        <span>•</span>
        <a href="https://fatturafacile.eu/" class="hover:text-slate-300">
          fatturafacile.eu
        </a>
      </div>
    </div>
  </div>
</footer>

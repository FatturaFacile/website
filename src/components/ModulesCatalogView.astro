---
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from './ModuleCard.astro';
import { MODULES_DATA, type ModuleItem } from '../data/modules';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

export interface Props {
  canonicalPath: string;
}

const { canonicalPath } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const m = t.moduli;

const availableModules: ModuleItem[] = MODULES_DATA.filter((item) => item.status === 'available');
const roadmapModules: ModuleItem[] = MODULES_DATA.filter((item) => item.status !== 'available');

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: m.seo.title,
  url: `https://fatturafacile.eu${getLocalizedPath(canonicalPath, lang)}`,
  inLanguage: lang,
  description: m.seo.description,
  publisher: {
    '@type': 'Organization',
    name: 'Fattura Facile Teams',
  },
};
---

<BaseLayout
  title={m.seo.title}
  description={m.seo.description}
  keywords={m.seo.keywords}
  lang={lang}
  schema={pageSchema}
>
  <section class="py-16 lg:py-24 bg-gradient-to-b from-slate-100/80 via-white to-slate-50 dark:from-slate-900 dark:via-slate-950 dark:to-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 dark:bg-teal-950/70 text-teal-800 dark:text-teal-300 mb-6">
        {m.eyebrow}
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        {m.heading}
      </h1>
      <p class="mt-6 text-base sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto">
        {m.lead}
      </p>
    </div>
  </section>

  <!-- 3 Functional Pillars -->
  <section class="py-16 bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700">
          <div class="w-12 h-12 rounded-2xl bg-teal-600 text-white flex items-center justify-center mb-6 shadow-md shadow-teal-600/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">
            Ciclo attivo semplificato
          </h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
            Creazione preventivi, note pro-forma, conferme d'ordine e conversione immediata in
            fattura di vendita con numerazione progressiva automatica.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700">
          <div class="w-12 h-12 rounded-2xl bg-slate-900 dark:bg-teal-500 text-white dark:text-slate-950 flex items-center justify-center mb-6 shadow-md shadow-slate-900/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">
            Anagrafica e Listini
          </h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
            Gestione clienti con validazione automatica di Partita IVA/Codice Fiscale (IT) e IDE/UID
            (CH); catalogo servizi/prodotti con descrizioni multi-riga e unità di misura
            personalizzabili.
          </p>
        </div>

        <div class="p-8 rounded-3xl bg-slate-50 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700">
          <div class="w-12 h-12 rounded-2xl bg-emerald-600 text-white flex items-center justify-center mb-6 shadow-md shadow-emerald-600/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">
            Personalizzazione stampe
          </h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
            Layout PDF puliti ed eleganti con logo aziendale, coordinate bancarie IBAN/BIC e note
            legali a piè di pagina.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Available Modules -->
  <section class="py-16 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-10">
        {m.availableSectionTitle}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {availableModules.map((mod) => (
          <ModuleCard module={mod} />
        ))}
      </div>
    </div>
  </section>

  <!-- Roadmap Modules -->
  <section id="roadmap" class="py-16 bg-slate-50 dark:bg-slate-900 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400">
          {m.requestForm.badge}
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-2">
          {m.roadmapSectionTitle}
        </h2>
        <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300">
          {m.requestForm.description}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {roadmapModules.map((mod) => (
          <ModuleCard module={mod} isRoadmap={true} />
        ))}
      </div>

      <div class="mt-14 text-center">
        <a
          href={getLocalizedPath('/community-richieste/', lang)}
          class="inline-flex items-center justify-center gap-2 px-8 py-3.5 bg-teal-600 hover:bg-teal-500 text-white font-bold rounded-xl text-sm shadow-md transition-all"
        >
          <span>{t.common.actions.requestModule}</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

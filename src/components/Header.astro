---
import type { Locale } from '../i18n/types';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';

export interface Props {
  lang?: Locale;
}

const currentPath = Astro.url.pathname;
const lang: Locale = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isProductActive =
  currentPath.includes('/perche') ||
  currentPath.includes('/funzionalita') ||
  currentPath.includes('/moduli') ||
  currentPath.includes('/versioni');
const isCommunityActive =
  currentPath.includes('/community-richieste') ||
  currentPath.includes('/scuole-e-sociale') ||
  currentPath.includes('/sponsor');
const isNetworkActive = currentPath.includes('/supporto-locale') || currentPath.includes('/faq');
const isAboutActive =
  currentPath.includes('/storia') ||
  currentPath.includes('/team') ||
  currentPath.includes('#storia') ||
  currentPath.includes('#team');

const dropdownSubtitles: Record<
  Locale,
  {
    whyUs: string;
    features: string;
    versions: string;
    requestModules: string;
    contribute: string;
    schools: string;
    sponsors: string;
    localSupport: string;
    faq: string;
    story: string;
    team: string;
  }
> = {
  it: {
    whyUs: 'Filosofia anti-ERP per artigiani e PMI',
    features: 'FatturaPA, Swiss QR-Bill e roadmap',
    versions: 'Desktop USB SQLite vs Docker Privato',
    requestModules: 'Sviluppo a costo zero rilasciato a tutti',
    contribute: 'Devs, commercialisti, traduttori e tester',
    schools: 'Didattica per istituti e impatto sociale',
    sponsors: 'Sostieni certificati e server CI/CD',
    localSupport: 'Tecnici e fiduciarie sul territorio',
    faq: 'Guida rapida a USB, backup e SDI/QR',
    story: "Dall'esigenza reale all'open source",
    team: 'Chi sviluppa e mantiene il progetto',
  },
  en: {
    whyUs: 'Anti-ERP philosophy for tradespeople & SMEs',
    features: 'FatturaPA, Swiss QR-Bill & public roadmap',
    versions: 'USB SQLite Desktop vs Private Docker',
    requestModules: 'Zero-cost custom modules shared with all',
    contribute: 'Devs, accountants, translators & testers',
    schools: 'Vocational education & social impact',
    sponsors: 'Support certificates & CI/CD build servers',
    localSupport: 'IT technicians & fiduciaries near you',
    faq: 'Quick guide to USB, backups & SDI/QR',
    story: 'From real field needs to open source',
    team: 'Who builds and maintains the project',
  },
  fr: {
    whyUs: 'Philosophie anti-ERP pour artisans et PME',
    features: 'FatturaPA, QR-facture suisse et roadmap',
    versions: 'Desktop USB SQLite vs Docker Privé',
    requestModules: 'Développement gratuit partagé avec tous',
    contribute: 'Devs, fiduciaires, traducteurs et testeurs',
    schools: 'Formation professionnelle et impact social',
    sponsors: 'Soutenir certificats et serveurs CI/CD',
    localSupport: 'Techniciens et fiduciaires de proximité',
    faq: 'Guide rapide clé USB, sauvegardes et SDI/QR',
    story: "Du besoin réel de terrain à l'open source",
    team: 'Qui développe et maintient le projet',
  },
  de: {
    whyUs: 'Anti-ERP-Philosophie für Handwerk & KMU',
    features: 'FatturaPA, Schweizer QR-Rechnung & Roadmap',
    versions: 'Desktop USB SQLite vs Privates Docker',
    requestModules: 'Kostenlose Module für alle veröffentlicht',
    contribute: 'Entwickler, Treuhänder, Übersetzer & Tester',
    schools: 'Berufsbildung & gesellschaftlicher Beitrag',
    sponsors: 'Zertifikate & CI/CD-Server unterstützen',
    localSupport: 'IT-Techniker und Treuhänder vor Ort',
    faq: 'Kurzanleitung zu USB, Backups & SDI/QR',
    story: 'Vom Praxisbedarf zur freien Software',
    team: 'Wer das Projekt entwickelt und pflegt',
  },
};

const sub = dropdownSubtitles[lang];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/95 dark:bg-slate-900/95 border-b border-slate-200/80 dark:border-slate-800 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Logo Branding -->
    <a
      href={getLocalizedPath('/', lang)}
      class="flex items-center gap-3 group shrink-0"
      aria-label={`${t.common.siteName} Home`}
      title={`${t.common.siteName} Home`}
      data-i18n-aria-label="logo_aria"
      data-i18n-title="logo_aria"
    >
      <svg
        class="h-10 w-10 shrink-0 transition-transform duration-300 group-hover:scale-105"
        viewBox="0 0 512 512"
        fill="none"
      >
        <path
          class="logo-stroke-adaptive"
          d="M 200,450 L 130,450 C 100,450 80,430 80,400 L 80,110 C 80,80 100,60 130,60 L 330,60"
          stroke="#0f172a"
          stroke-width="26"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          class="logo-stroke-adaptive"
          d="M 330,60 L 420,150 L 420,280"
          stroke="#0f172a"
          stroke-width="26"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          class="logo-stroke-adaptive"
          d="M 330,60 L 330,150 L 420,150"
          stroke="#0f172a"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <line
          class="logo-stroke-adaptive"
          x1="150"
          y1="180"
          x2="270"
          y2="180"
          stroke="#0f172a"
          stroke-width="22"
          stroke-linecap="round"
        />
        <line
          class="logo-stroke-adaptive"
          x1="150"
          y1="240"
          x2="235"
          y2="240"
          stroke="#0f172a"
          stroke-width="22"
          stroke-linecap="round"
        />
        <path
          d="M 135,335 L 168,368 L 215,310"
          stroke="#10b981"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M 235,455 A 52,52 0 0 1 230,365 A 72,72 0 0 1 345,300 A 82,82 0 0 1 455,365 A 56,56 0 0 1 445,455 Z"
          fill="#0d9488"
        />
        <line
          x1="345"
          y1="452"
          x2="345"
          y2="375"
          stroke="#FFFFFF"
          stroke-width="13"
          stroke-linecap="round"
        />
        <circle cx="345" cy="370" r="11" fill="#FFFFFF" />
        <path
          d="M 295,452 L 295,415 L 313,397"
          stroke="#FFFFFF"
          stroke-width="11"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="313" cy="397" r="9" fill="#FFFFFF" />
        <path
          d="M 395,452 L 395,417 L 377,399"
          stroke="#FFFFFF"
          stroke-width="11"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="377" cy="399" r="9" fill="#FFFFFF" />
      </svg>
      <div class="flex flex-col">
        <span class="text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-none">
          Fattura<span class="text-teal-600 dark:text-teal-400">Facile</span>
        </span>
        <span
          class="text-[11px] font-semibold text-slate-500 dark:text-slate-400 mt-1"
          data-i18n="logo_claim"
        >
          {t.common.tagline}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation with Dropdowns -->
    <nav class="hidden lg:flex items-center space-x-6 text-sm font-medium text-slate-600 dark:text-slate-300">
      <!-- 1. Product Dropdown -->
      <div class="relative group py-2">
        <button
          type="button"
          class={`flex items-center gap-1.5 transition-colors group-hover:text-teal-600 dark:group-hover:text-teal-400 focus:outline-none ${isProductActive ? 'text-teal-600 dark:text-teal-400 font-bold' : ''}`}
          aria-haspopup="true"
        >
          <span>{t.common.nav.product}</span>
          <svg
            class="w-4 h-4 transition-transform group-hover:rotate-180 duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </button>
        <div class="absolute left-0 mt-2 w-64 rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200 dark:border-slate-800 p-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
          <a
            href={getLocalizedPath('/perche/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.whyUs}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.whyUs}</span>
          </a>
          <a
            href={getLocalizedPath('/funzionalita/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.featuresModules}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.features}</span>
          </a>
          <a
            href={getLocalizedPath('/versioni/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.offlineVsCloud}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.versions}</span>
          </a>
        </div>
      </div>

      <!-- 2. Community & Social Dropdown -->
      <div class="relative group py-2">
        <button
          type="button"
          class={`flex items-center gap-1.5 transition-colors group-hover:text-teal-600 dark:group-hover:text-teal-400 focus:outline-none ${isCommunityActive ? 'text-teal-600 dark:text-teal-400 font-bold' : ''}`}
          aria-haspopup="true"
        >
          <span>{t.common.nav.communitySocial}</span>
          <svg
            class="w-4 h-4 transition-transform group-hover:rotate-180 duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </button>
        <div class="absolute left-0 mt-2 w-72 rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200 dark:border-slate-800 p-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
          <a
            href={getLocalizedPath('/community-richieste/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-teal-600 dark:text-teal-400 text-xs">
              {t.common.nav.requestModulesFree}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.requestModules}</span>
          </a>
          <a
            href={`${getLocalizedPath('/community-richieste/', lang)}#collaborare`}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.contribute}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.contribute}</span>
          </a>
          <a
            href={getLocalizedPath('/scuole-e-sociale/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.schoolsSocial}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.schools}</span>
          </a>
          <a
            href={getLocalizedPath('/sponsor/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.sponsors}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.sponsors}</span>
          </a>
        </div>
      </div>

      <!-- 3. Network & Support Dropdown -->
      <div class="relative group py-2">
        <button
          type="button"
          class={`flex items-center gap-1.5 transition-colors group-hover:text-teal-600 dark:group-hover:text-teal-400 focus:outline-none ${isNetworkActive ? 'text-teal-600 dark:text-teal-400 font-bold' : ''}`}
          aria-haspopup="true"
        >
          <span>{t.common.nav.networkSupport}</span>
          <svg
            class="w-4 h-4 transition-transform group-hover:rotate-180 duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </button>
        <div class="absolute left-0 mt-2 w-64 rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200 dark:border-slate-800 p-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
          <a
            href={getLocalizedPath('/supporto-locale/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.localSupport}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.localSupport}</span>
          </a>
          <a
            href={getLocalizedPath('/faq/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">{t.common.nav.faq}</span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.faq}</span>
          </a>
        </div>
      </div>

      <!-- 4. About Dropdown / Links -->
      <div class="relative group py-2">
        <button
          type="button"
          class={`flex items-center gap-1.5 transition-colors group-hover:text-teal-600 dark:group-hover:text-teal-400 focus:outline-none ${isAboutActive ? 'text-teal-600 dark:text-teal-400 font-bold' : ''}`}
          aria-haspopup="true"
        >
          <span>{t.common.nav.about}</span>
          <svg
            class="w-4 h-4 transition-transform group-hover:rotate-180 duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </button>
        <div class="absolute right-0 mt-2 w-64 rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200 dark:border-slate-800 p-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
          <a
            href={getLocalizedPath('/storia/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.story}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.story}</span>
          </a>
          <a
            href={getLocalizedPath('/team/', lang)}
            class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.team}
            </span>
            <span class="text-[11px] text-slate-500 dark:text-slate-400">{sub.team}</span>
          </a>
          <a
            href={getLocalizedPath('/privacy/', lang)}
            class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors border-t border-slate-100 dark:border-slate-800/80 mt-1"
          >
            <span class="font-bold text-slate-900 dark:text-white text-xs">
              {t.common.nav.privacy}
            </span>
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Controls: Dark/Light Mode, Language & Mobile Hamburger -->
    <div class="flex items-center gap-2 sm:gap-3">
      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        onclick="window.toggleTheme()"
        aria-label="Toggle light/dark theme"
        title="Toggle light/dark theme"
        data-i18n-aria-label="theme_toggle_aria"
        data-i18n-title="theme_toggle_title"
        class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors"
      >
        <svg
          id="theme-icon-light"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          id="theme-icon-dark"
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Language Selector -->
      <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300">
        <a
          id="lang-it-btn"
          href={getLocalizedPath(currentPath, 'it')}
          onclick="localStorage.setItem('lang', 'it')"
          class={`px-2 py-1 rounded-lg transition-all duration-200 ${lang === 'it' ? 'tab-active' : ''}`}
          title="Italiano"
          aria-label="Italiano"
          data-i18n-title="lang_it"
          data-i18n-aria-label="lang_it"
        >
          IT
        </a>
        <a
          id="lang-en-btn"
          href={getLocalizedPath(currentPath, 'en')}
          onclick="localStorage.setItem('lang', 'en')"
          class={`px-2 py-1 rounded-lg transition-all duration-200 ${lang === 'en' ? 'tab-active' : ''}`}
          title="English"
          aria-label="English"
          data-i18n-title="lang_en"
          data-i18n-aria-label="lang_en"
        >
          EN
        </a>
        <a
          id="lang-fr-btn"
          href={getLocalizedPath(currentPath, 'fr')}
          onclick="localStorage.setItem('lang', 'fr')"
          class={`px-2 py-1 rounded-lg transition-all duration-200 ${lang === 'fr' ? 'tab-active' : ''}`}
          title="Français"
          aria-label="Français"
          data-i18n-title="lang_fr"
          data-i18n-aria-label="lang_fr"
        >
          FR
        </a>
        <a
          id="lang-de-btn"
          href={getLocalizedPath(currentPath, 'de')}
          onclick="localStorage.setItem('lang', 'de')"
          class={`px-2 py-1 rounded-lg transition-all duration-200 ${lang === 'de' ? 'tab-active' : ''}`}
          title="Deutsch"
          aria-label="Deutsch"
          data-i18n-title="lang_de"
          data-i18n-aria-label="lang_de"
        >
          DE
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg
          id="hamburger-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 pt-4 pb-8 space-y-6 max-h-[calc(100vh-5rem)] overflow-y-auto"
  >
    <!-- Product Group -->
    <div>
      <div class="text-xs font-bold uppercase tracking-wider text-teal-600 dark:text-teal-400 mb-2">
        {t.common.nav.product}
      </div>
      <div class="space-y-1 pl-2">
        <a
          href={getLocalizedPath('/perche/', lang)}
          class="block py-1.5 text-sm font-medium text-slate-700 dark:text-slate-200 hover:text-teal-600 dark:hover:text-teal-400"
        >
          {t.common.nav.whyUs}
        </a>
        <a
          href={getLocalizedPath('/funzionalita/', lang)}

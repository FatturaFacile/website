---
import type { Locale } from '../i18n/types';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import { DEMO_URL } from '../data/links';
import { a11yLabels } from '../i18n/a11y';

export interface Props {
  lang?: Locale;
}

const currentPath = Astro.url.pathname;
const lang: Locale = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const isProductActive =
  currentPath.includes('/perche') ||
  currentPath.includes('/funzionalita') ||
  currentPath.includes('/moduli') ||
  currentPath.includes('/versioni');
const isCommunityActive =
  currentPath.includes('/community') ||
  currentPath.includes('/contribuisci') ||
  currentPath.includes('/scuole-e-sociale') ||
  currentPath.includes('/sponsor');
const isNetworkActive = currentPath.includes('/supporto-locale') || currentPath.includes('/faq');
const isAboutActive =
  currentPath.includes('/storia') ||
  currentPath.includes('/team') ||
  currentPath.includes('#storia') ||
  currentPath.includes('#team');

const dropdownSubtitles: Record<
  Locale,
  Record<
    | 'whyUs'
    | 'features'
    | 'versions'
    | 'requestModules'
    | 'contribute'
    | 'contributeGuide'
    | 'schools'
    | 'sponsors'
    | 'localSupport'
    | 'faq'
    | 'story'
    | 'team',
    string
  >
> = {
  it: {
    whyUs: 'Perché è gratis, semplice e tuo',
    features: 'Preventivi, fatture e cosa stiamo aggiungendo',
    versions: 'Web disponibile, Windows e telefono in arrivo',
    requestModules: 'Ti manca qualcosa? Lo aggiungiamo gratis',
    contribute: 'Programmatori, commercialisti, traduttori e chi prova',
    contributeGuide: 'Come iniziare: issue, branch e pull request',
    schools: 'Programma gratuito per scuole e chi inizia',
    sponsors: 'Aiuta a coprire le spese del progetto',
    localSupport: 'Tecnici e fiduciarie vicino a te',
    faq: 'Prezzo, dati, backup, fattura elettronica e QR-Bill',
    story: 'Come è nato il progetto',
    team: 'Chi ci lavora',
  },
  en: {
    whyUs: 'Why it is free, simple and yours',
    features: 'Quotes, invoices and what we are adding',
    versions: 'Web available, Windows and phone coming',
    requestModules: 'Missing something? We add it for free',
    contribute: 'Developers, accountants, translators and testers',
    contributeGuide: 'How to start: issues, branches and pull requests',
    schools: 'Free program for schools and people starting out',
    sponsors: 'Help cover the costs of the project',
    localSupport: 'Technicians and fiduciaries near you',
    faq: 'Price, data, backups, e-invoicing and QR-bill',
    story: 'How the project began',
    team: 'Who works on it',
  },
  fr: {
    whyUs: 'Pourquoi il est gratuit, simple et à vous',
    features: 'Devis, factures et ce que nous ajoutons',
    versions: 'Web disponible, Windows et téléphone bientôt',
    requestModules: "Il vous manque quelque chose ? Nous l'ajoutons gratuitement",
    contribute: 'Développeurs, comptables, traducteurs et testeurs',
    contributeGuide: 'Par où commencer : issues, branches et pull requests',
    schools: 'Logiciel gratuit pour les écoles et celles et ceux qui débutent',
    sponsors: 'Aidez à couvrir les frais du projet',
    localSupport: 'Techniciens et fiduciaires près de chez vous',
    faq: 'Prix, données, sauvegardes, facture électronique et QR-facture',
    story: 'Comment le projet est né',
    team: 'Qui y travaille',
  },
  de: {
    whyUs: 'Warum es kostenlos, einfach und Ihr eigenes ist',
    features: 'Offerten, Rechnungen und was wir hinzufügen',
    versions: 'Web verfügbar, Windows und Handy folgen',
    requestModules: 'Fehlt etwas? Wir fügen es kostenlos hinzu',
    contribute: 'Entwickler, Buchhalter, Übersetzer und Tester',
    contributeGuide: 'So starten Sie: Issues, Branches und Pull Requests',
    schools: 'Kostenloses Programm für Schulen und den Start',
    sponsors: 'Helfen Sie, die Projektkosten zu decken',
    localSupport: 'Techniker und Treuhänder in Ihrer Nähe',
    faq: 'Preis, Daten, Sicherungen, E-Rechnung und QR-Rechnung',
    story: 'Wie das Projekt entstand',
    team: 'Wer daran arbeitet',
  },
};

const sub = dropdownSubtitles[lang];

interface NavGroupItem {
  label: string;
  href: string;
  subtitle?: string;
  highlight?: boolean;
  hasStatusDot?: boolean;
}

interface NavGroup {
  title: string;
  isActive: boolean;
  alignRight?: boolean;
  wide?: boolean;
  items: NavGroupItem[];
}

const navGroups: NavGroup[] = [
  {
    title: t.common.nav.product,
    isActive: isProductActive,
    items: [
      { label: t.common.nav.whyUs, href: getLocalizedPath('/perche/', lang), subtitle: sub.whyUs },
      {
        label: t.common.nav.featuresModules,
        href: getLocalizedPath('/funzionalita/', lang),
        subtitle: sub.features,
      },
      {
        label: t.common.nav.offlineVsCloud,
        href: getLocalizedPath('/versioni/', lang),
        subtitle: sub.versions,
      },
    ],
  },
  {
    title: t.common.nav.communitySocial,
    isActive: isCommunityActive,
    wide: true,
    items: [
      {
        label: 'Community Open Source',
        href: getLocalizedPath('/community/', lang),
        subtitle: sub.contribute,
        highlight: true,
      },
      {
        label: t.common.nav.contribute,
        href: getLocalizedPath('/contribuisci/', lang),
        subtitle: sub.contributeGuide,
      },
      {
        label: t.common.nav.requestModulesFree,
        href: getLocalizedPath('/community-richieste/', lang),
        subtitle: sub.requestModules,
      },
      {
        label: t.common.nav.schoolsSocial,
        href: getLocalizedPath('/scuole-e-sociale/', lang),
        subtitle: sub.schools,
      },
      {
        label: t.common.nav.sponsors,
        href: getLocalizedPath('/sponsor/', lang),
        subtitle: sub.sponsors,
      },
    ],
  },
  {
    title: t.common.nav.networkSupport,
    isActive: isNetworkActive,
    items: [
      {
        label: t.common.nav.localSupport,
        href: getLocalizedPath('/supporto-locale/', lang),
        subtitle: sub.localSupport,
      },
      { label: t.common.nav.faq, href: getLocalizedPath('/faq/', lang), subtitle: sub.faq },
    ],
  },
  {
    title: t.common.nav.about,
    isActive: isAboutActive,
    alignRight: true,
    items: [
      { label: t.common.nav.story, href: getLocalizedPath('/storia/', lang), subtitle: sub.story },
      { label: t.common.nav.team, href: getLocalizedPath('/team/', lang), subtitle: sub.team },
      {
        label: t.common.nav.privacy,
        href: getLocalizedPath('/privacy/', lang),
        hasStatusDot: true,
      },
    ],
  },
];

const langOptions: Array<{ code: Locale; label: string; title: string; i18nKey: string }> = [
  { code: 'it', label: 'IT', title: 'Italiano', i18nKey: 'lang_it' },
  { code: 'en', label: 'EN', title: 'English', i18nKey: 'lang_en' },
  { code: 'fr', label: 'FR', title: 'Français', i18nKey: 'lang_fr' },
  { code: 'de', label: 'DE', title: 'Deutsch', i18nKey: 'lang_de' },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/95 dark:bg-slate-900/95 border-b border-slate-200/80 dark:border-slate-800 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between gap-2">
    <!-- Logo Branding -->
    <a
      href={getLocalizedPath('/', lang)}
      class="flex items-center gap-2 sm:gap-3 group min-w-0"
      title={`${t.common.siteName} Home`}
      data-i18n-title="logo_aria"
    >
      <svg
        class="h-8 w-8 sm:h-10 sm:w-10 shrink-0 transition-transform duration-300 group-hover:scale-105"
        width="40"
        height="40"
        viewBox="0 0 512 512"
        fill="none"
        aria-hidden="true"
      >
        <path
          class="logo-stroke-adaptive"
          d="M 200,450 L 130,450 C 100,450 80,430 80,400 L 80,110 C 80,80 100,60 130,60 L 330,60"
          stroke="#0f172a"
          stroke-width="26"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          class="logo-stroke-adaptive"
          d="M 330,60 L 420,150 L 420,280"
          stroke="#0f172a"
          stroke-width="26"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          class="logo-stroke-adaptive"
          d="M 330,60 L 330,150 L 420,150"
          stroke="#0f172a"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <line
          class="logo-stroke-adaptive"
          x1="150"
          y1="180"
          x2="270"
          y2="180"
          stroke="#0f172a"
          stroke-width="22"
          stroke-linecap="round"
        />
        <line
          class="logo-stroke-adaptive"
          x1="150"
          y1="240"
          x2="235"
          y2="240"
          stroke="#0f172a"
          stroke-width="22"
          stroke-linecap="round"
        />
        <path
          d="M 135,335 L 168,368 L 215,310"
          stroke="#10b981"
          stroke-width="24"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M 235,455 A 52,52 0 0 1 230,365 A 72,72 0 0 1 345,300 A 82,82 0 0 1 455,365 A 56,56 0 0 1 445,455 Z"
          fill="#0d9488"
        />
        <line
          x1="345"
          y1="452"
          x2="345"
          y2="375"
          stroke="#FFFFFF"
          stroke-width="13"
          stroke-linecap="round"
        />
        <circle cx="345" cy="370" r="11" fill="#FFFFFF" />
        <path
          d="M 295,452 L 295,415 L 313,397"
          stroke="#FFFFFF"
          stroke-width="11"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="313" cy="397" r="9" fill="#FFFFFF" />
        <path
          d="M 395,452 L 395,417 L 377,399"
          stroke="#FFFFFF"
          stroke-width="11"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle cx="377" cy="399" r="9" fill="#FFFFFF" />
      </svg>
      <div class="flex flex-col min-w-0">
        <span class="text-base min-[400px]:text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-none whitespace-nowrap">
          Fattura<span class="text-teal-700 dark:text-teal-400">Facile</span>
        </span>
        <span
          class="hidden sm:block text-xs font-semibold text-slate-500 dark:text-slate-400 mt-1"
          data-i18n="logo_claim"
        >
          {t.common.tagline}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation with Dropdowns -->
    <nav class="hidden lg:flex items-center space-x-6 text-sm font-medium text-slate-600 dark:text-slate-300">
      {navGroups.map((group) => (
        <div class="nav-dropdown relative group py-2">
          <button
            type="button"
            class={`nav-dropdown-trigger flex items-center gap-1.5 rounded-md transition-colors group-hover:text-teal-700 dark:group-hover:text-teal-400 ${
              group.isActive
                ? 'text-teal-700 dark:text-teal-400 font-bold underline underline-offset-8 decoration-2'
                : ''
            }`}
            aria-haspopup="true"
            aria-expanded="false"
          >
            <span>{group.title}</span>
            <svg
              class="w-4 h-4 transition-transform group-hover:rotate-180 duration-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              ></path>
            </svg>
          </button>
          <div
            class={`nav-dropdown-panel absolute ${group.alignRight ? 'right-0' : 'left-0'} mt-2 ${
              group.wide ? 'w-72' : 'w-64'
            } rounded-2xl bg-white dark:bg-slate-900 shadow-2xl border border-slate-200 dark:border-slate-800 p-2 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50`}
          >
            {group.items.map((item) =>
              item.hasStatusDot ? (
                <a
                  href={item.href}
                  class="flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors border-t border-slate-100 dark:border-slate-800/80 mt-1"
                >
                  <span class="font-bold text-slate-900 dark:text-white text-xs">{item.label}</span>
                  <span class="w-2 h-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                  <span class="sr-only">({a11yLabels[lang].compliant})</span>
                </a>
              ) : (
                <a
                  href={item.href}
                  class="flex flex-col px-3.5 py-2.5 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800 transition-colors"
                >
                  <span
                    class={`font-bold text-xs ${
                      item.highlight
                        ? 'text-teal-700 dark:text-teal-400'
                        : 'text-slate-900 dark:text-white'
                    }`}
                  >
                    {item.label}
                  </span>
                  {item.subtitle && (
                    <span class="text-xs text-slate-500 dark:text-slate-400">{item.subtitle}</span>
                  )}
                </a>
              ),
            )}
          </div>
        </div>
      ))}
    </nav>

    <!-- Controls: Dark/Light Mode, Language & Mobile Hamburger -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        onclick="window.toggleTheme()"
        aria-label="Toggle light/dark theme"
        title="Toggle light/dark theme"
        data-i18n-aria-label="theme_toggle_aria"
        data-i18n-title="theme_toggle_title"
        class="hidden sm:block p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors"
      >
        <svg
          id="theme-icon-light"
          class="w-5 h-5 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
          ></path>
        </svg>
        <svg
          id="theme-icon-dark"
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
          ></path>
        </svg>
      </button>

      <!-- Language Selector -->
      <div class="flex items-center bg-slate-100 dark:bg-slate-800 p-0.5 sm:p-1 rounded-xl border border-slate-200 dark:border-slate-700 text-xs font-bold text-slate-600 dark:text-slate-300">
        {langOptions.map((opt) => (
          <a
            id={`lang-${opt.code}-btn`}
            href={getLocalizedPath(currentPath, opt.code)}
            onclick={`localStorage.setItem('lang', '${opt.code}')`}
            class={`px-1.5 sm:px-2 py-1 rounded-lg transition-all duration-200 ${
              lang === opt.code ? 'tab-active' : ''
            }`}
            title={opt.title}
            hreflang={opt.code}
            aria-current={lang === opt.code ? 'page' : undefined}
            data-i18n-title={opt.i18nKey}
          >
            {opt.label}
          </a>
        ))}
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden shrink-0 p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-700 transition-colors"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          id="hamburger-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          ></path>
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md px-4 pt-4 pb-8 space-y-6 max-h-[calc(100dvh-4rem)] sm:max-h-[calc(100dvh-5rem)] overflow-y-auto"
  >
    {navGroups.map((group) => (
      <div>
        <div class="text-xs font-bold uppercase tracking-wider text-teal-700 dark:text-teal-400 mb-2">
          {group.title}
        </div>
        <div class="space-y-1 pl-2">
          {group.items.map((item) => (
            <a
              href={item.href}
              class={`block py-1.5 text-sm font-medium ${
                item.highlight
                  ? 'text-teal-700 dark:text-teal-400 font-bold'
                  : 'text-slate-700 dark:text-slate-200 hover:text-teal-700 dark:hover:text-teal-400'
              }`}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>
    ))}

    <!-- Theme toggle (the header one is hidden on very small screens) -->
    <button
      type="button"
      onclick="window.toggleTheme()"
      aria-label="Toggle light/dark theme"
      data-i18n-aria-label="theme_toggle_aria"
      class="sm:hidden flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-200"
    >
      <svg
        class="w-5 h-5 dark:hidden"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
        ></path>
      </svg>
      <svg
        class="w-5 h-5 hidden dark:block"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
        ></path>
      </svg>
    </button>

    <!-- Direct CTA -->
    <div class="pt-4 border-t border-slate-200 dark:border-slate-800">
      <a
        href={DEMO_URL}
        target="_blank"
        rel="noopener"
        class="w-full flex items-center justify-center gap-2 px-6 py-3 bg-teal-700 text-white font-bold rounded-xl text-sm shadow-md"
      >
        {t.common.actions.tryDemo}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (mobileBtn && mobileMenu) {
      const setMenu = (open) => {
        mobileBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
        mobileMenu.classList.toggle('hidden', !open);
        if (hamburgerIcon) hamburgerIcon.classList.toggle('hidden', open);
        if (closeIcon) closeIcon.classList.toggle('hidden', !open);
      };
      mobileBtn.addEventListener('click', () => {
        setMenu(mobileBtn.getAttribute('aria-expanded') !== 'true');
      });
      // Escape closes the menu and returns focus to the button.
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileBtn.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          mobileBtn.focus();
        }
      });
      // Reset when the layout switches to the desktop navigation.
      window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches) setMenu(false);
      });
    }

    // Desktop dropdowns: keep aria-expanded in sync with the CSS hover/focus-within
    // visibility, and allow dismissing with Escape (focus returns to the trigger).
    document.querySelectorAll('.nav-dropdown').forEach((group) => {
      const trigger = group.querySelector('.nav-dropdown-trigger');
      if (!trigger) return;

      const setExpanded = (open) => {
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      const open = () => {
        group.removeAttribute('data-dismissed');
        setExpanded(true);
      };
      const close = () => {
        group.setAttribute('data-dismissed', '');
        setExpanded(false);
      };

      group.addEventListener('mouseenter', open);
      group.addEventListener('mouseleave', () => {
        group.removeAttribute('data-dismissed');
        setExpanded(group.contains(document.activeElement));
      });
      group.addEventListener('focusin', (e) => {
        // Tabbing into the menu items re-opens a menu dismissed with Escape.
        if (e.target !== trigger) group.removeAttribute('data-dismissed');
        if (!group.hasAttribute('data-dismissed')) setExpanded(true);
      });
      group.addEventListener('focusout', (e) => {
        if (!group.contains(e.relatedTarget)) {
          group.removeAttribute('data-dismissed');
          setExpanded(group.matches(':hover'));
        }
      });
      trigger.addEventListener('click', (e) => {
        // Keyboard activation (detail === 0) toggles; a mouse click always opens.
        if (e.detail === 0 && trigger.getAttribute('aria-expanded') === 'true') close();
        else open();
      });
      group.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
          e.preventDefault();
          close();
          trigger.focus();
        }
      });
    });
  });
</script>

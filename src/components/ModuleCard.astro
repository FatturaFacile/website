---
import { MODULE_STATUS_STYLES, MARKET_SCOPE_FLAGS, type ModuleItem } from '../data/modules';
import type { ModuleIdKey } from '../i18n/types';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

export interface Props {
  module: ModuleItem;
  isRoadmap?: boolean;
}

const { module: mod, isRoadmap = false } = Astro.props;
const m = useTranslations(getLangFromUrl(Astro.url)).moduli;
const text = m.modules[mod.id as ModuleIdKey];
const badgeSuffix = isRoadmap
  ? ` • ${mod.plannedMilestone ?? m.milestoneTbd}`
  : mod.version
    ? ` • ${mod.version}`
    : '';
---

<div
  id={mod.id}
  class={`flex flex-col justify-between border border-slate-200 dark:border-slate-800 rounded-3xl p-6 sm:p-8 transition-all ${
    isRoadmap ? 'bg-white dark:bg-slate-950' : 'bg-slate-50/70 dark:bg-slate-900/60 hover:shadow-xl'
  }`}
>
  <div>
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <span
        class={`px-2.5 py-1 rounded-full text-xs font-bold border ${MODULE_STATUS_STYLES[mod.status]}`}
      >
        {m.status[mod.status]}
        {badgeSuffix}
      </span>
      <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">
        {MARKET_SCOPE_FLAGS[mod.market]} {m.markets[mod.market]}
      </span>
    </div>
    <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{text.title}</h3>
    <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
      {text.description}
    </p>
  </div>
  <ul class="space-y-2 border-t border-slate-200 dark:border-slate-800 pt-4 text-xs text-slate-600 dark:text-slate-400">
    {text.features.map((f) => (
      <li class="flex items-center gap-2">
        <span class="text-teal-600 dark:text-teal-400 font-bold">{isRoadmap ? '•' : '✓'}</span>
        <span>{f}</span>
      </li>
    ))}
  </ul>
</div>

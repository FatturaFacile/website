---
import type { Locale } from '../i18n/types';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import {
  DEMO_URL,
  DOCS_URL,
  GITHUB_MAIN_REPO_URL,
  GITHUB_ORG_URL,
  MIT_LICENSE_GITHUB_URL,
  MIT_LICENSE_OSI_URL,
  TELEGRAM_URL,
} from '../data/links';
import { serializeJsonLd } from '../utils/security';
import GoogleAnalytics from './GoogleAnalytics.astro';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
  lang?: Locale;
  alternates?: Record<Locale | 'x-default', string>;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const detectedLang = getLangFromUrl(Astro.url);
const lang: Locale = Astro.props.lang ?? detectedLang;
const t = useTranslations(lang);

const siteOrigin = (Astro.site?.origin ?? 'https://fatturafacile.eu').replace(/\/$/, '');
const normalizedCurrentPath = getLocalizedPath(Astro.url.pathname, lang);

const defaultAlternates: Record<Locale | 'x-default', string> = {
  it: `${siteOrigin}${getLocalizedPath(Astro.url.pathname, 'it')}`,
  en: `${siteOrigin}${getLocalizedPath(Astro.url.pathname, 'en')}`,
  fr: `${siteOrigin}${getLocalizedPath(Astro.url.pathname, 'fr')}`,
  de: `${siteOrigin}${getLocalizedPath(Astro.url.pathname, 'de')}`,
  'x-default': `${siteOrigin}${getLocalizedPath(Astro.url.pathname, 'it')}`,
};

const {
  title = t.home.seo.title,
  description = t.home.seo.description,
  keywords = t.home.seo.keywords,
  canonicalUrl = `${siteOrigin}${normalizedCurrentPath}`,
  ogImage = 'https://fatturafacile.eu/img/og-image.png',
  alternates = defaultAlternates,
  schema,
} = Astro.props;

const ogLocaleMap: Record<Locale, string> = {
  it: 'it_IT',
  en: 'en_US',
  fr: 'fr_CH',
  de: 'de_CH',
};

const activeOgLocale = ogLocaleMap[lang];
const allOgLocales = ['it_IT', 'it_CH', 'en_US', 'fr_CH', 'de_CH'];
const alternateOgLocales = allOgLocales.filter((loc) => loc !== activeOgLocale);

const sameAsLinks = [GITHUB_ORG_URL, GITHUB_MAIN_REPO_URL, DOCS_URL, TELEGRAM_URL, DEMO_URL];

const organizationSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${siteOrigin}/#organization`,
  name: 'FatturaFacile',
  alternateName: 'FatturaFacile - free invoicing',
  url: `${siteOrigin}/`,
  logo: {
    '@type': 'ImageObject',
    url: `${siteOrigin}/img/fattura_facile_logo.svg`,
    width: 512,
    height: 512,
  },
  email: 'info@fatturafacile.eu',
  areaServed: [
    {
      '@type': 'Country',
      name: 'Switzerland',
      identifier: 'CH',
    },
    {
      '@type': 'Country',
      name: 'Italy',
      identifier: 'IT',
    },
  ],
  sameAs: sameAsLinks,
};

const defaultSoftwareSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${siteOrigin}/#software`,
  name: t.common.siteName,
  alternateName: 'FatturaFacile',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Invoicing and quotes',
  operatingSystem: 'Web',
  inLanguage: ['it', 'en', 'fr', 'de'],
  isAccessibleForFree: true,
  license: [MIT_LICENSE_OSI_URL, MIT_LICENSE_GITHUB_URL],
  codeRepository: GITHUB_MAIN_REPO_URL,
  repository: GITHUB_ORG_URL,
  downloadUrl: GITHUB_ORG_URL,
  sameAs: [GITHUB_ORG_URL, DOCS_URL, TELEGRAM_URL],
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'CHF',
      availability: 'https://schema.org/InStock',
      url: `${siteOrigin}${getLocalizedPath('/', lang)}`,
    },
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock',
      url: `${siteOrigin}${getLocalizedPath('/', lang)}`,
    },
  ],
  description: t.home.seo.description,
  url: `${siteOrigin}${getLocalizedPath('/', lang)}`,
  author: {
    '@id': `${siteOrigin}/#organization`,
  },
  publisher: {
    '@id': `${siteOrigin}/#organization`,
  },
  featureList: t.home.schemaFeatures,
};

const pageSchemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const finalSchemas: Array<Record<string, unknown>> = [
  organizationSchema,
  defaultSoftwareSchema,
  ...pageSchemas,
];
---

<!-- Global Metadata -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="FatturaFacile Team" />
<meta
  name="robots"
  content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
/>
<meta
  name="googlebot"
  content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
/>
<link rel="canonical" href={canonicalUrl} />

<!-- Geographic Meta -->
<meta name="geo.region" content="CH;IT" />
<meta name="geo.placename" content="Switzerland; Italy" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />
<meta name="theme-color" content="#0d9488" />

<!-- Alternate Locales & Dual-Country Hreflang (CH / IT) -->
<link rel="alternate" hreflang="it" href={alternates.it} />
<link rel="alternate" hreflang="it-CH" href={alternates.it} />
<link rel="alternate" hreflang="it-IT" href={alternates.it} />
<link rel="alternate" hreflang="en" href={alternates.en} />
<link rel="alternate" hreflang="fr" href={alternates.fr} />
<link rel="alternate" hreflang="fr-CH" href={alternates.fr} />
<link rel="alternate" hreflang="de" href={alternates.de} />
<link rel="alternate" hreflang="de-CH" href={alternates.de} />
<link rel="alternate" hreflang="x-default" href={alternates['x-default']} />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="FatturaFacile" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:secure_url" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={activeOgLocale} />
{alternateOgLocales.map((altLoc) => (
  <meta property="og:locale:alternate" content={altLoc} />
))}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

<!-- Favicon & Icons -->
<link rel="icon" type="image/svg+xml" href="/img/fattura_facile_favicon.svg" />
<link rel="alternate icon" href="/img/favicon/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png" />
<link rel="manifest" href="/img/favicon/site.webmanifest" />

<!-- Google Analytics 4 (GA4) -->
<GoogleAnalytics />

<!-- Structured Data (JSON-LD) -->
{finalSchemas.map((s) => (
  /* eslint-disable-next-line astro/no-set-html-directive */
  <script type="application/ld+json" is:inline set:html={serializeJsonLd(s)} />
))}

---
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../i18n/utils';
import type { Locale } from '../i18n/types';

export interface Props {
  lang?: Locale;
}

const lang: Locale = Astro.props.lang ?? getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const c = t.common.cookieBanner;
const btn =
  'inline-flex items-center justify-center min-h-11 px-5 py-2 rounded-lg text-sm font-bold border-2 border-teal-700 bg-white text-teal-900 hover:bg-teal-50 dark:bg-slate-900 dark:text-teal-200 dark:border-teal-400 dark:hover:bg-slate-800 focus-visible:outline focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-teal-600 cursor-pointer flex-1 sm:flex-none sm:min-w-32';
---

<div
  id="cookie-banner"
  role="dialog"
  aria-labelledby="cookie-banner-title"
  aria-describedby="cookie-banner-text"
  tabindex="-1"
  hidden
  class="fixed inset-x-0 bottom-0 z-[90] p-3 sm:p-4"
>
  <div class="max-w-3xl mx-auto bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 border border-slate-300 dark:border-slate-700 rounded-2xl shadow-2xl p-5 max-h-[85vh] overflow-y-auto">
    <h2 id="cookie-banner-title" class="text-base font-bold">{c.title}</h2>
    <p id="cookie-banner-text" class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
      {c.text}{' '}
      <a
        href={getLocalizedPath('/privacy/', lang)}
        class="underline font-semibold text-teal-800 dark:text-teal-300"
      >
        {c.privacyLink}
      </a>
    </p>
    <p id="cookie-banner-state" class="mt-2 text-xs font-semibold text-slate-600 dark:text-slate-300" hidden>
    </p>
    <div class="mt-4 flex flex-col-reverse sm:flex-row gap-3 sm:justify-end">
      <button type="button" id="cookie-reject" class={btn}>{c.reject}</button>
      <button type="button" id="cookie-accept" class={btn}>{c.accept}</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ stateGranted: c.stateGranted, stateDenied: c.stateDenied }}>
  (function () {
    const banner = document.getElementById('cookie-banner');
    const stateEl = document.getElementById('cookie-banner-state');
    if (!banner) return;
    let opener = null;

    function show(fromUser) {
      const current = window.ffConsent && window.ffConsent.get();
      if (current) {
        stateEl.textContent = current === 'granted' ? stateGranted : stateDenied;
        stateEl.hidden = false;
      } else {
        stateEl.hidden = true;
      }
      opener = fromUser && document.activeElement instanceof HTMLElement ? document.activeElement : null;
      banner.hidden = false;
      if (fromUser) banner.focus();
    }

    function choose(choice) {
      if (window.ffConsent) window.ffConsent.set(choice);
      banner.hidden = true;
      if (opener && document.contains(opener)) opener.focus();
      opener = null;
    }

    document.getElementById('cookie-accept').addEventListener('click', function () {
      choose('granted');
    });
    document.getElementById('cookie-reject').addEventListener('click', function () {
      choose('denied');
    });

    window.openCookiePreferences = function () {
      show(true);
    };

    // Prima visita (nessuna scelta salvata): mostra il banner.
    if (window.ffConsent && !window.ffConsent.get()) show(false);
  })();
</script>
